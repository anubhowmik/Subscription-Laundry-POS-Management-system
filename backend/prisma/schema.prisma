// Saudi Laundry Management System - Database Schema
// Multi-tenant SaaS: every tenant is an Organization. See docs/POS-ZATCA-PLAN.md for ZATCA
// e-invoicing details and docs/MULTI-TENANT-PLAN.md (if present) for tenancy notes.
//
// Scope built so far: auth/RBAC, business locations, master data, inventory, sales/POS,
// ZATCA e-invoicing (Phases A-D), multi-tenant foundation (Organization + Plan/Subscription
// skeleton - payment collection itself is a later phase, not yet built).
//
// NOTE: a platform-level "manage all tenants" super-admin panel is NOT built yet - every User
// in this schema belongs to exactly one Organization for now. That's a deliberate scope cut,
// not an oversight.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum TaxType {
  INCLUSIVE
  EXCLUSIVE
}

enum ProductType {
  STANDARD
  VARIABLE
}

enum SaleStatus {
  DRAFT
  FINAL
  CANCELLED
}

enum PaymentStatus {
  PAID
  PARTIAL
  DUE
  OVERPAID
}

// Server-computed from the sale's actual line items at checkout - never client-supplied. Null
// only for historical sales predating this field with zero items (shouldn't exist in practice).
enum SaleType {
  PRODUCT
  SERVICE
  MIXED
}

// Reference's own `is_direct_sale` column on `transactions` - both "POS Sale" (the touch-grid
// screen) and "Add Sale" (the back-office table screen) hit the exact same checkout endpoint in
// the reference (and in this app - see pos.service.ts checkout()'s "channel" comment), so this is
// the one signal that actually distinguishes which FRONTEND a sale was rung up through. Purely
// informational/filtering - "List POS" (POS-channel only) vs "All Sales" (unfiltered, both
// channels) are the same underlying data, scoped differently - see sale.service.ts's list().
enum SaleChannel {
  POS
  ADD_SALE
}

enum InventoryTransactionType {
  STOCK_IN
  STOCK_OUT
  SALE
  SALE_RETURN
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
}

enum CompensationReason {
  LOST
  DAMAGED
  DELAYED
  OTHER
}

enum CompensationStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum LoyaltyTransactionType {
  EARN
  REDEEM
  ADJUSTMENT
}

enum BookingType {
  PICKUP
  DELIVERY
}

enum BookingStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum NotificationProvider {
  UNIFONIC
  // The email channel added for "Send Notification" (see notifications.service.ts's
  // sendTemplatedEmail()) - logged under this value regardless of which EmailSender
  // (mock/resend/smtp, see emailSender.ts) actually delivered it, since NotificationLog tracks
  // which app CHANNEL was used, not the specific outbound provider config.
  RESEND
}

enum NotificationStatus {
  SENT
  FAILED
  TEST // provider not configured/enabled yet - logged instead of actually sent, per-org "log mode"
}

// Matches the reference site's return-reason taxonomy exactly (Not Washable, Damaged, Not
// Found, or a generic Sell Return/Other).
// Matches the reference's own return-reason list exactly (sell_return/add.blade.php) - it has
// no "Other" catch-all, just these three.
enum SellReturnReason {
  NOT_WASHABLE
  DAMAGED
  NOT_FOUND
}

enum PaymentType {
  SALE_PAYMENT
  REFUND
}

enum PurchaseStatus {
  RECEIVED
  CANCELLED
}

// The reference site's "Inventory Counting" module turned out to be a periodic branch
// reconciliation - not a product stock-take. Its "Create Inventory Posting" screen buckets open
// laundry orders into In Stock / In Warehouse / Out Stock and pairs that with a cash-in-drawer
// count, then saves the whole thing as an audit record. We already track per-item state via
// ItemFulfillmentStatus and cash counts via RegisterSession; InventoryPosting is the periodic
// snapshot that ties both together the way the reference site does.
enum InventoryPostingStatus {
  PENDING
  CONFIRMED
}

// Which bucket a classified sale was placed into when it was added to an Inventory Posting -
// matches the reference's own 3-button classify action (InventoryPostingController@create's
// $("#status") in_stock/out_stock/in_warehouse) exactly.
enum InventoryPostingSaleStatus {
  IN_STOCK
  OUT_STOCK
  IN_WAREHOUSE
}

// The reference site's "Announcements" module: a date-ranged notice, optionally scoped to one
// business location (null = all locations), with a published/draft toggle.
model Announcement {
  id             String   @id @default(uuid())
  organizationId String
  fromDate       DateTime
  toDate         DateTime
  content        String   @db.Text
  isPublished    Boolean  @default(true)
  createdBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByUser User                   @relation(fields: [createdBy], references: [id])
  locations     AnnouncementLocation[]

  @@index([organizationId])
}

// No rows for an announcement = targets every business location (matches the reference site's
// "empty locations_id = all locations" behavior). Replaces a single nullable FK because the
// reference site lets an announcement target several specific branches at once, not just one or all.
model AnnouncementLocation {
  announcementId     String
  businessLocationId String

  announcement     Announcement     @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  businessLocation BusinessLocation @relation(fields: [businessLocationId], references: [id], onDelete: Cascade)

  @@id([announcementId, businessLocationId])
  @@index([businessLocationId])
}

// The reference site's "Messages" module turned out to be branch-to-branch, not user-to-user:
// every message is addressed From one BusinessLocation To another (e.g. a branch escalating a
// customer complaint to HQ), and "Reply" just opens a new compose form with locations swapped -
// there's no threaded conversation view, so parentMessageId here is for traceability only.

// Kept separate from SellReturnReason - a purchase going back to a vendor fails for different
// reasons than a customer returning a finished garment.
enum PurchaseReturnReason {
  DEFECTIVE
  WRONG_ITEM
  OVERSTOCK
  OTHER
}

// Per-item garment lifecycle, tracked independently of the invoice-level SaleStatus.
enum ItemFulfillmentStatus {
  PENDING
  IN_PROGRESS
  READY
  DELIVERED
  CANCELLED
}

// Chart of Accounts - Phase 1 (see project_coa_full_system_of_record memory: user wants a full
// system of record, not the audit's lightweight-reference default). Asset/Expense are
// debit-normal; Liability/Equity/Revenue are credit-normal - see accounting/account.service.ts's
// getBalance() for how this sign convention is applied.
enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum RegisterSessionStatus {
  OPEN
  CLOSED
}

enum CouponDiscountMode {
  PERCENT
  FIXED
}

// ZATCA (Fatoora) e-invoicing enums - see docs/POS-ZATCA-PLAN.md
enum ZatcaInvoiceType {
  STANDARD // B2B/B2G - buyer has a VAT number - requires Clearance (pre-delivery)
  SIMPLIFIED // B2C - requires Reporting (post-delivery, within 24h)
}

enum ZatcaTransactionType {
  INVOICE
  CREDIT_NOTE
  DEBIT_NOTE
}

enum ZatcaClearanceStatus {
  NOT_SUBMITTED // Phase A/B: hash chain + QR exist locally, no ZATCA API call made yet
  PENDING
  CLEARED
  REPORTED
  FAILED
  QUEUED_OFFLINE
}

enum TaxCategoryCode {
  S // Standard rate
  Z // Zero-rated
  E // Exempt
  O // Out of scope
}

enum ZatcaCertificateStatus {
  KEY_GENERATED // EC keypair + CSR created locally, nothing submitted to ZATCA yet
  COMPLIANCE_ISSUED // Phase D: compliance CSID obtained
  PRODUCTION_ISSUED // Phase D: production CSID obtained
  FAILED
}

// --- Multi-tenant / billing enums ---

enum OrganizationStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum BillingInterval {
  MONTHLY
  ANNUAL
  LIFETIME // one-time payment, never expires - Subscription.currentPeriodEnd stays null
}

enum BillingPaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// What a BillingPayment is actually for. SUBSCRIPTION = the org's own recurring base seat
// ($10/mo or annual); SEAT_LICENSE = a one-time $10 charge for one additional user seat.
// These are deliberately decoupled from each other - see user.service.ts assertUserSeatAvailable()
// and billing.service.ts verifyPayment(), which branch on this field but never let one purpose's
// verification affect the other's state (Organization.status/Subscription for SUBSCRIPTION,
// Organization.purchasedUserSeats for SEAT_LICENSE).
enum BillingPaymentPurpose {
  SUBSCRIPTION
  SEAT_LICENSE
}

// ---------------------------------------------------------------------------
// Global geography reference data - matches the reference app's Country/State/City tables
// (its Suppliers/Customers form uses real cascading dropdowns, not free text). Global, not
// organization-scoped - seeded once via prisma/seed.ts from a public world dataset, read-only
// from the app's perspective. Supplier/Customer still store the resolved NAME as plain text
// (unchanged), not a foreign key - these tables exist purely to power the picker.
// ---------------------------------------------------------------------------

model Country {
  id        String  @id @default(uuid())
  code      String  @unique // ISO2, e.g. "SA"
  nameEn    String
  nameAr    String?
  phoneCode String?
  states    State[]

  @@index([nameEn])
}

model State {
  id        String  @id @default(uuid())
  countryId String
  nameEn    String
  // Only populated for Arabic-speaking countries - the source dataset's "native" name is in
  // each country's own native script (French for France, etc.), not necessarily Arabic, so it's
  // only trustworthy as `nameAr` when the country's native language actually is Arabic.
  nameAr    String?
  country   Country @relation(fields: [countryId], references: [id], onDelete: Cascade)
  cities    City[]

  @@index([countryId])
}

model City {
  id      String  @id @default(uuid())
  stateId String
  nameEn  String
  // No Arabic city names in the source dataset (150k+ cities) - always null. UI falls back to
  // nameEn the same way it already does for any other nullable nameAr field.
  nameAr  String?
  state   State   @relation(fields: [stateId], references: [id], onDelete: Cascade)

  @@index([stateId])
}

// ---------------------------------------------------------------------------
// Multi-tenant foundation
// ---------------------------------------------------------------------------

model Organization {
  id          String             @id @default(uuid())
  nameEn      String
  nameAr      String
  slug        String             @unique // url-safe identifier
  status      OrganizationStatus @default(TRIAL)
  trialEndsAt DateTime?

  // Included with the org's own base subscription seat; every additional active login-capable
  // user beyond this count requires a one-time $10 seat purchase - see
  // user.service.ts assertUserSeatAvailable() and billing.service.ts createSeatCheckout().
  // Defaults to 1 (the owner's own seat). Deliberately independent of Subscription/trial state -
  // see the BillingPaymentPurpose comment above.
  purchasedUserSeats Int @default(1)

  // --- Org-wide settings (P6-4) ---
  fiscalYearStartMonth Int     @default(1) // 1-12
  dateFormat           String  @default("DD/MM/YYYY")
  timeFormat24h        Boolean @default(false)
  reportHeaderText     String?
  reportFooterText     String?
  logoUrl              String?
  themeColor           String? // hex accent color
  rewardPointsEnabled  Boolean @default(true)
  rewardPointsName     String  @default("Points")
  pointValueSar        Decimal @default(0.1) @db.Decimal(6, 3) // SAR value of 1 redeemed point - replaces the old hardcoded POINT_VALUE constant
  pointsEarnDivisor    Decimal @default(10) @db.Decimal(6, 2) // SAR spent per point earned - replaces the old hardcoded EARN_DIVISOR constant
  minOrderForPoints    Decimal @default(0) @db.Decimal(12, 2)
  maxPointsPerOrder    Int?
  minRedeemPoints      Int     @default(0)
  maxRedeemPoints      Int?
  pointsExpiryDays     Int?

  // --- Payment reminder scheduler (P7-4) - see backend/src/jobs/paymentReminder.job.ts ---
  paymentReminderEnabled      Boolean @default(false)
  paymentReminderAfterDays    Int     @default(7) // days overdue before the first reminder
  paymentReminderIntervalDays Int     @default(7) // days between repeat reminders

  // --- Customer approval workflow (P8-3) - when on, new customers start PENDING and are blocked
  // from checkout until approved. Off by default so existing orgs see no behavior change. ---
  customerApprovalRequired Boolean @default(false)

  // --- Contact custom field labels - shared config for both Customer and Supplier custom_field1-10,
  // matching the reference's shared `custom_labels['contact']` config. Null means "not configured
  // by this business" and the frontend shows the generic "Custom Field N" default. ---
  contactCustomField1Label  String?
  contactCustomField2Label  String?
  contactCustomField3Label  String?
  contactCustomField4Label  String?
  contactCustomField5Label  String?
  contactCustomField6Label  String?
  contactCustomField7Label  String?
  contactCustomField8Label  String?
  contactCustomField9Label  String?
  contactCustomField10Label String?

  // --- Sale custom field labels - matching the reference's own separate `custom_labels['sell']`
  // config (distinct from the contact one above - the reference itself keeps these as two
  // independent label sets, only 4 slots here vs 10 for contacts). Null means "not configured by
  // this business" and the frontend shows the generic "Custom Field N" default. ---
  sellCustomField1Label String?
  sellCustomField2Label String?
  sellCustomField3Label String?
  sellCustomField4Label String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                  User[]
  roles                  Role[]
  userGroups             UserGroup[]
  businessLocations      BusinessLocation[]
  businessLocationGroups BusinessLocationGroup[]
  customerGroups         CustomerGroup[]
  customers              Customer[]
  accounts               Account[]
  journalEntries         JournalEntry[]
  paymentAccountTypes    PaymentAccountType[]
  paymentAccounts        PaymentAccount[]
  categories             Category[]
  brands                 Brand[]
  units                  Unit[]
  taxes                  Tax[]
  products               Product[]
  serviceCategories      ServiceCategory[]
  services               Service[]
  paymentMethods         PaymentMethod[]
  sales                  Sale[]
  auditLogs              AuditLog[]
  billingPayments        BillingPayment[]
  subscription           Subscription?
  registerSessions       RegisterSession[]
  heldSales              HeldSale[]
  coupons                Coupon[]
  priceLists             PriceList[]
  compensations          Compensation[]
  loyaltyTransactions    LoyaltyTransaction[]
  cashbackTransactions   CashbackTransaction[]
  bookings               Booking[]
  notificationSettings   NotificationSettings?
  notificationLogs       NotificationLog[]
  notificationTemplates  NotificationTemplate[]
  sellReturns            SellReturn[]
  suppliers              Supplier[]
  purchases              Purchase[]
  purchaseReturns        PurchaseReturn[]
  inventoryPostings      InventoryPosting[]
  messages               Message[]
  announcements          Announcement[]
  stockTransfers         StockTransfer[]
  expenseCategories      ExpenseCategory[]
  expenses               Expense[]
  stockAdjustments       StockAdjustment[]
  bnplProviderSettings   BnplProviderSettings[]
  bnplSessions           BnplSession[]
}

// Billing plan catalog - global, not tenant-scoped (the plans a tenant can subscribe to).
model Plan {
  id            String   @id @default(uuid())
  code          String   @unique // "starter" | "pro" | "enterprise"
  nameEn        String
  nameAr        String
  priceMonthly  Decimal  @db.Decimal(10, 2)
  priceAnnual   Decimal  @db.Decimal(10, 2)
  priceLifetime Decimal? @db.Decimal(10, 2) // null = this plan is not sold as a one-time lifetime purchase
  maxBranches   Int? // null = unlimited
  maxUsers      Int? // null = unlimited
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscriptions   Subscription[]
  billingPayments BillingPayment[]
}

// One subscription per Organization.
//
// Access is decided from DATES, not from `status` alone - see billing/entitlement.service.ts.
// That means no cron job is needed to "expire" anything: a trial whose currentPeriodEnd has
// passed simply stops granting access the next time it is checked. `status` is descriptive.
//
// currentPeriodEnd is NULL only for LIFETIME subscriptions, which never expire.
model Subscription {
  id                 String             @id @default(uuid())
  organizationId     String             @unique
  planId             String
  status             SubscriptionStatus @default(TRIALING)
  billingInterval    BillingInterval    @default(MONTHLY)
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime? // null = lifetime, never expires
  cancelAtPeriodEnd  Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id])
  plan            Plan             @relation(fields: [planId], references: [id])
  billingPayments BillingPayment[]
}

// What a COMPANY pays US to use the platform. Deliberately separate from SalePayment, which is
// what a company's own walk-in customer pays THEM at the POS counter.
model BillingPayment {
  id                 String                @id @default(uuid())
  organizationId     String
  subscriptionId     String?
  planId             String? // null for SEAT_LICENSE purchases, which aren't tied to a plan/subscription
  purpose            BillingPaymentPurpose @default(SUBSCRIPTION)
  seatQuantity       Int? // set only for SEAT_LICENSE purpose - how many one-time seats this payment buys
  amount             Decimal               @db.Decimal(10, 2)
  currency           String                @default("SAR")
  billingInterval    BillingInterval? // null for SEAT_LICENSE purpose - one-time, not a recurring interval
  status             BillingPaymentStatus  @default(PENDING)
  gateway            String                @default("moyasar")
  gatewayPaymentId   String?               @unique // Moyasar payment id, set once the payment is created there
  gatewayResponseRaw Json?
  failureReason      String?
  paidAt             DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  plan         Plan?         @relation(fields: [planId], references: [id])

  @@index([organizationId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Auth / RBAC (tenant-scoped)
// ---------------------------------------------------------------------------

model Role {
  id             String   @id @default(uuid())
  organizationId String
  nameEn         String
  nameAr         String
  description    String?
  isSystem       Boolean  @default(false) // built-in roles cannot be deleted
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users           User[]
  rolePermissions RolePermission[]

  @@unique([organizationId, nameEn])
  @@index([organizationId])
}

// Global catalog of permission codes - same across every tenant, not tenant-scoped.
model Permission {
  id          String   @id @default(uuid())
  code        String   @unique // e.g. "users.view"
  module      String // e.g. "users"
  description String?
  createdAt   DateTime @default(now())

  rolePermissions      RolePermission[]
  userGroupPermissions UserGroupPermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id                  String     @id @default(uuid())
  organizationId      String
  username            String?    @unique // null for non-login staff (P8-5) - Postgres unique index permits multiple nulls
  email               String?    @unique
  passwordHash        String? // null when allowLogin is false - login/changePassword must guard this, never compare against null
  fullNameEn          String
  fullNameAr          String?
  phone               String?
  roleId              String
  role                Role       @relation(fields: [roleId], references: [id])
  status              UserStatus @default(ACTIVE)
  isSystemAdmin       Boolean    @default(false) // full access within their OWN organization only - bypasses business-location scoping, does not cross tenant boundaries
  allowLogin          Boolean    @default(true) // false = a staff record that exists only to be referenced (e.g. createdBy) - see (a) in P8-5
  maxDiscountPercent  Decimal?   @db.Decimal(5, 2) // null = unlimited - per-cashier invoice-discount ceiling (P8-5b), never applies to isSystemAdmin
  // Email verification gate - see auth.service.ts verifyEmailCode(). New users default to false;
  // existing users as of the migration that introduced this column are backfilled to true (they
  // predate this concept and already have working accounts).
  emailVerified       Boolean    @default(false)
  // Per-user override on top of the role's app.* permission codes - null inherits the role's
  // grant, true force-grants even if the role lacks the code, false force-revokes even if the
  // role has it. Computed into req.user.permissions by middleware/authenticate.ts. See the
  // "Application Access" page in the Users & Rules application.
  appAccessPosLaundry Boolean?
  appAccessUsersRules Boolean?
  appAccessZatca      Boolean?
  lastLoginAt         DateTime?
  createdBy           String?
  updatedBy           String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  deletedAt           DateTime?

  organization                     Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessLocations                UserBusinessLocation[]
  userGroups                       UserUserGroup[]
  refreshTokens                    RefreshToken[]
  loginAttempts                    LoginAttempt[]
  auditLogs                        AuditLog[]
  sales                            Sale[]
  payments                         Payment[]
  inventoryTxns                    InventoryTransaction[]
  saleItemStatusChanges            SaleItemStatusHistory[]
  registerSessionsOpened           RegisterSession[]           @relation("RegisterSessionOpenedBy")
  registerSessionsClosed           RegisterSession[]           @relation("RegisterSessionClosedBy")
  heldSales                        HeldSale[]
  compensationsCreated             Compensation[]              @relation("CompensationCreatedBy")
  compensationsResolved            Compensation[]              @relation("CompensationResolvedBy")
  loyaltyTransactions              LoyaltyTransaction[]
  cashbackTransactions             CashbackTransaction[]
  bookingsCreated                  Booking[]
  sellReturnsCreated               SellReturn[]
  purchasesCreated                 Purchase[]
  purchaseReturnsCreated           PurchaseReturn[]
  inventoryPostingsCreated         InventoryPosting[]
  messagesSent                     Message[]
  messageReads                     MessageRead[]
  announcementsCreated             Announcement[]
  stockTransfersCreated            StockTransfer[]             @relation("StockTransferCreatedBy")
  stockTransfersReceived           StockTransfer[]             @relation("StockTransferReceivedBy")
  expensesCreated                  Expense[]
  stockAdjustmentsCreated          StockAdjustment[]
  customerRestrictions             UserCustomer[]
  customerGroupRestrictions        UserCustomerGroup[]
  transferFromLocationRestrictions UserTransferFromLocation[]
  bnplSessionsCreated              BnplSession[]
  emailVerificationCodes           EmailVerificationCode[]
  paymentAccountsCreated           PaymentAccount[]
  paymentAccountTxnsCreated        PaymentAccountTransaction[]

  @@index([status])
  @@index([organizationId])
}

// Short-lived, single-use email verification codes (registration + resend). The raw code is
// never stored - only its hash, same discipline as RefreshToken.tokenHash below.
model EmailVerificationCode {
  id           String    @id @default(uuid())
  userId       String
  codeHash     String
  expiresAt    DateTime
  consumedAt   DateTime?
  attemptCount Int       @default(0)
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserGroup {
  id                 String     @id @default(uuid())
  organizationId     String
  nameEn             String
  nameAr             String
  description        String?
  businessLocationId String?
  status             UserStatus @default(ACTIVE)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  organization     Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessLocation BusinessLocation?     @relation(fields: [businessLocationId], references: [id])
  permissions      UserGroupPermission[]
  users            UserUserGroup[]

  @@index([organizationId])
}

model UserGroupPermission {
  userGroupId  String
  permissionId String
  userGroup    UserGroup  @relation(fields: [userGroupId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userGroupId, permissionId])
}

model UserUserGroup {
  userId      String
  userGroupId String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userGroup   UserGroup @relation(fields: [userGroupId], references: [id], onDelete: Cascade)

  @@id([userId, userGroupId])
}

model UserBusinessLocation {
  userId             String
  businessLocationId String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessLocation   BusinessLocation @relation(fields: [businessLocationId], references: [id], onDelete: Cascade)

  @@id([userId, businessLocationId])
}

// Per-user access restrictions (P8-5c/d) - unlike UserBusinessLocation above, EMPTY rows here mean
// UNRESTRICTED (matches today's default behavior with zero migration pain - most users get zero
// restriction rows and nothing changes for them). Only a user with at least one row here is
// actually limited to that set. See authenticate.ts for how this is computed into req.user.
model UserCustomer {
  userId     String
  customerId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@id([userId, customerId])
}

model UserCustomerGroup {
  userId          String
  customerGroupId String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerGroup   CustomerGroup @relation(fields: [customerGroupId], references: [id], onDelete: Cascade)

  @@id([userId, customerGroupId])
}

model UserTransferFromLocation {
  userId             String
  businessLocationId String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessLocation   BusinessLocation @relation(fields: [businessLocationId], references: [id], onDelete: Cascade)

  @@id([userId, businessLocationId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Platform operator (the SaaS owner) - DELIBERATELY separate from User.
//
// A PlatformAdmin is not a member of any Organization. Keeping these accounts in their own
// table, with their own refresh tokens and their own JWT type claim, means there is no code
// path by which a tenant's user can be promoted into a platform operator - the tenant-facing
// user API physically cannot write to this table.
//
// Per the product decision, a platform operator sees company METADATA only (status, plan,
// payments). There is no impersonation and no endpoint that exposes a tenant's customers,
// sales, or invoices.
// ---------------------------------------------------------------------------

model PlatformAdmin {
  id           String     @id @default(uuid())
  username     String     @unique
  email        String     @unique
  passwordHash String
  fullName     String
  status       UserStatus @default(ACTIVE)
  // The one admin no other admin can deactivate or password-reset - every other admin is fully
  // equal to every other, this is the single exception. Set on exactly one row (backfilled onto
  // the earliest-created admin in the migration that added this column); createAdmin() never
  // grants it to a new admin - there is currently no UI path to transfer or grant ownership.
  isOwner      Boolean    @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  refreshTokens PlatformRefreshToken[]
}

model PlatformRefreshToken {
  id              String    @id @default(uuid())
  platformAdminId String
  tokenHash       String    @unique
  userAgent       String?
  ipAddress       String?
  expiresAt       DateTime
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  platformAdmin PlatformAdmin @relation(fields: [platformAdminId], references: [id], onDelete: Cascade)

  @@index([platformAdminId])
}

model LoginAttempt {
  id        String   @id @default(uuid())
  userId    String?
  username  String
  success   Boolean
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([username])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Business Locations
// ---------------------------------------------------------------------------

model BusinessLocation {
  id                    String     @id @default(uuid())
  organizationId        String
  businessNameEn        String
  businessNameAr        String
  branchName            String
  branchNameAr          String?
  branchCode            String
  address               String?
  city                  String?
  district              String?
  postalCode            String?
  buildingNo            String? // ZATCA national address building number
  phone                 String?
  email                 String?
  vatNumber             String?
  crNumber              String?
  nationalAddress       String?
  currency              String     @default("SAR")
  timezone              String     @default("Asia/Riyadh")
  status                UserStatus @default(ACTIVE)
  lastIcv               Int        @default(0) // ZATCA Invoice Counter Value - last issued, per location
  groupId               String?
  defaultPriceListId    String?
  receiptPrinterType    String     @default("browser") // "browser" | "printer" - no distinct Printer entity yet, just the toggle
  printReceiptOnInvoice Boolean    @default(true)
  printerName           String? // human-readable name/identifier of the configured receipt printer (P7-5)
  paperWidthMm          Int? // drives the default invoice templateKey suggestion for this branch (P7-5)

  // --- Document numbering (P7-5, extended P8-1) - moved from Organization to per-branch. Each
  // pair is an atomic row-lock counter, same pattern as lastIcv above. All kinds share one
  // yearly-reset event: the first number claimed of any kind after the calendar year rolls over
  // (when numberResetYearly is on) zeroes every sequence together and stamps lastNumberResetYear,
  // rather than resetting independently. ---
  invoiceNumberPrefix    String  @default("INV-")
  lastInvoiceSeq         Int     @default(0)
  quoteNumberPrefix      String  @default("QT-")
  lastQuoteSeq           Int     @default(0)
  draftNumberPrefix      String  @default("DFT-")
  lastDraftSeq           Int     @default(0)
  returnNumberPrefix     String  @default("CN-")
  lastReturnSeq          Int     @default(0)
  reissueNumberPrefix    String  @default("RE-")
  lastReissueSeq         Int     @default(0)
  expenseNumberPrefix    String  @default("EXP-")
  lastExpenseSeq         Int     @default(0)
  adjustmentNumberPrefix String  @default("ADJ-")
  lastAdjustmentSeq      Int     @default(0)
  paymentNumberPrefix    String  @default("SP-")
  lastPaymentSeq         Int     @default(0)
  numberResetYearly      Boolean @default(false)
  lastNumberResetYear    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization                 Organization                     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  group                        BusinessLocationGroup?           @relation(fields: [groupId], references: [id])
  defaultPriceList             PriceList?                       @relation(fields: [defaultPriceListId], references: [id])
  invoiceLayoutSettings        InvoiceLayoutSettings[]
  users                        UserBusinessLocation[]
  userGroups                   UserGroup[]
  customers                    Customer[]
  products                     ProductBusinessLocation[]
  services                     ServiceBusinessLocation[]
  productStocks                ProductStock[]
  sales                        Sale[]
  inventoryTxns                InventoryTransaction[]
  payments                     Payment[]
  zatcaCertificate             ZatcaDeviceCertificate?
  registerSessions             RegisterSession[]
  heldSales                    HeldSale[]
  compensations                Compensation[]
  bookings                     Booking[]
  sellReturns                  SellReturn[]
  suppliers                    Supplier[]
  purchases                    Purchase[]
  purchaseReturns              PurchaseReturn[]
  inventoryPostings            InventoryPosting[]
  messagesFrom                 Message[]                        @relation("MessageFromLocation")
  messagesTo                   Message[]                        @relation("MessageToLocation")
  announcementLocations        AnnouncementLocation[]
  stockTransfersFrom           StockTransfer[]                  @relation("StockTransferFrom")
  stockTransfersTo             StockTransfer[]                  @relation("StockTransferTo")
  coupons                      Coupon[]
  expenses                     Expense[]
  stockAdjustments             StockAdjustment[]
  userTransferFromRestrictions UserTransferFromLocation[]
  bnplSessions                 BnplSession[]
  defaultPaymentAccounts       BusinessLocationPaymentAccount[]

  @@unique([organizationId, branchCode])
  @@index([organizationId])
  @@index([status])
  @@index([groupId])
}

// Per-branch invoice/receipt display config (P7-5), extended into a real named catalog - a
// branch can now have SEVERAL named layouts (matches the reference's own "Invoice Layout for
// Sale" field, which lists real named templates like "Default Invoice Layout"/"Home Services" -
// confirmed on the live reference instance), with exactly one flagged `isDefault` per branch.
// businessLocationId is no longer @unique - see invoiceLayouts module for the CRUD/default-flip
// logic. A location with zero rows still renders "standard" with every toggle on, unchanged.
model InvoiceLayoutSettings {
  id                 String  @id @default(uuid())
  businessLocationId String
  name               String  @default("Default Layout")
  isDefault          Boolean @default(true)
  templateKey        String  @default("standard") // standard | thermal58 | thermal80 | a4Full | a5 | garmentTag
  logoUrl            String?
  accentColor        String? // hex

  // Show/hide toggles - all default true so an unconfigured row renders every field the original
  // single-template InvoicePage.tsx always rendered unconditionally.
  showLogo                 Boolean @default(true)
  showBranchName           Boolean @default(true)
  showCity                 Boolean @default(true)
  showQrCode               Boolean @default(true)
  showVatNumber            Boolean @default(true)
  showCrNumber             Boolean @default(true)
  showInvoiceUuid          Boolean @default(true)
  showIcv                  Boolean @default(true)
  showCustomerVat          Boolean @default(true)
  showCustomerPhone        Boolean @default(true)
  showItemSku              Boolean @default(true)
  showDiscountLine         Boolean @default(true)
  showPaidDue              Boolean @default(true)
  showEstimatedReady       Boolean @default(true)
  showRegisterSession      Boolean @default(true)
  showDigitalSignatureNote Boolean @default(true)

  // Sparse { [labelKey]: { en, ar } } map - a missing key falls back to the hardcoded default text
  // (see DEFAULT_LABELS in the frontend templates module).
  labelOverrides Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businessLocation BusinessLocation @relation(fields: [businessLocationId], references: [id], onDelete: Cascade)
  customers        Customer[]

  @@index([businessLocationId])
}

// Groups branches (e.g. by city/region) mainly for reporting roll-ups - mirrors the reference
// site's business_location_groups table.
model BusinessLocationGroup {
  id             String   @id @default(uuid())
  organizationId String
  nameEn         String
  nameAr         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  locations    BusinessLocation[]

  @@index([organizationId])
}

// ZATCA (Fatoora) e-invoicing: one signing identity per business location ("EGS unit" in
// ZATCA's terminology). See docs/POS-ZATCA-PLAN.md Phase C.
model ZatcaDeviceCertificate {
  id                        String                 @id @default(uuid())
  businessLocationId        String                 @unique
  privateKeyEncrypted       String                 @db.Text // AES-256-GCM encrypted PKCS8 PEM
  publicKeyPem              String                 @db.Text
  csrPem                    String?                @db.Text
  status                    ZatcaCertificateStatus @default(KEY_GENERATED)
  // Phase D fields (populated once we actually call ZATCA's onboarding APIs):
  complianceRequestId       String? // returned alongside the compliance CSID, needed for the production CSID exchange
  complianceCsid            String?                @db.Text
  complianceSecretEncrypted String?
  productionCsid            String?                @db.Text
  productionSecretEncrypted String?
  lastError                 String?
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt

  businessLocation BusinessLocation @relation(fields: [businessLocationId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Customers
// ---------------------------------------------------------------------------

// Matches the EJADA reference's CustomerGroup.price_calculation_type - mutually exclusive with
// each other (see priceListResolver.ts): PERCENTAGE applies `discountPercent` to the base price,
// SELLING_PRICE_GROUP applies the group's `priceListId` instead. Defaults to SELLING_PRICE_GROUP
// here (NOT the reference's own "percentage" default) specifically so a group that already had a
// `priceListId` configured before this field existed keeps behaving exactly as before - switching
// the default to match the reference literally would have silently stopped applying every
// pre-existing group price list the moment this migration ran.
enum PriceCalculationType {
  PERCENTAGE
  SELLING_PRICE_GROUP
}

// Matches the reference's `max_for` radio (For Customer / For Company) - whether the monthly caps
// below are enforced per-individual-customer or across the group's combined total. Nullable/COMPANY
// both mean "combined" (the only behavior this system had before this field existed), matching
// pos.service.ts's checkout() cap-enforcement query.
enum CustomerGroupCapScope {
  CUSTOMER
  COMPANY
}

// Matches the reference's `invoice_type` radio (Delivery Invoice / Final Invoice) - this system's
// own DRAFT/FINAL Sale.status IS the delivery-ticket-vs-finalized-invoice distinction the reference
// describes, so this genuinely drives checkout() defaulting a new sale to DRAFT when unset by the
// caller (see pos.service.ts).
enum CustomerGroupInvoiceType {
  DELIVERY
  FINAL
}

// Reference's `pay_term_type` (days/months) alongside `pay_term_number` - Customer/Supplier
// previously only had a days-only paymentTermsDays (a disclosed gap since the very first Supplier
// round). Resurfaces on Add Sale's own Pay Term field, which pre-fills from the contact's own
// configured type - see Sale.payTermType below.
enum PayTermType {
  DAYS
  MONTHS
}

model CustomerGroup {
  id               String     @id @default(uuid())
  organizationId   String
  nameEn           String
  nameAr           String
  description      String?
  discountPercent  Decimal    @default(0) @db.Decimal(5, 2)
  creditLimit      Decimal    @default(0) @db.Decimal(12, 2)
  paymentTermsDays Int        @default(0)
  priceListId      String? // negotiated pricing for this whole group (e.g. a corporate contract) - a customer's own priceListId wins over this
  status           UserStatus @default(ACTIVE)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  // --- Monthly spend/volume caps (P8-3) - all null = unrestricted, matching Coupon's established
  // all-null-unrestricted targeting convention. Enforced across the WHOLE group's combined FINAL
  // sales in the current calendar month by default (maxFor null/COMPANY), or per-individual-
  // customer when maxFor=CUSTOMER - checked at checkout in pos.service.ts. ---
  maxAmountPerMonth   Decimal?               @db.Decimal(12, 2)
  maxInvoicesPerMonth Int?
  maxQtyPerMonth      Decimal?               @db.Decimal(12, 3)
  maxFor              CustomerGroupCapScope?

  // --- Reference-parity fields added when cross-checking this module against the EJADA reference
  // (CustomerGroupController.php) - see priceListResolver.ts and pos.service.ts for where each one
  // actually takes effect, and customer_group_full_reference_parity's migration note for defaults
  // chosen to avoid changing behavior for any group created before this migration. ---
  defaultAccountId     String?
  priceCalculationType PriceCalculationType     @default(SELLING_PRICE_GROUP)
  isCorporate          Boolean                  @default(false)
  taxNumber            String?
  // Default true (NOT the reference's own unchecked-by-default) - this system already sends a
  // NEW_SALE/PAYMENT_RECEIVED SMS unconditionally for every customer regardless of group, so
  // defaulting new groups to false would silently go quiet for every org already relying on that.
  sendSms              Boolean                  @default(true)
  // No "manual price override at POS" capability exists anywhere in this system yet (checkout only
  // ever prices from the product/service's own price or a resolved price list - see priceLine() in
  // pos.service.ts) - stored faithfully but has no enforcement point to gate until that capability
  // is built as its own feature.
  priceEditable        Boolean                  @default(false)
  invoiceType          CustomerGroupInvoiceType @default(FINAL)

  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  priceList        PriceList?          @relation(fields: [priceListId], references: [id])
  defaultAccount   Account?            @relation(fields: [defaultAccountId], references: [id])
  customers        Customer[]
  coupons          Coupon[]
  userRestrictions UserCustomerGroup[]
  sales            Sale[]
  sellReturns      SellReturn[]

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Chart of Accounts - Phase 1 (ledger core: accounts + a real balanced double-entry journal,
// no automatic posting yet - see accounting module comments for the Phase 2 scope). Matches the
// reference's Account/AccountType 2-level hierarchy, converted from EJADA's "Account" contact
// field which routes a Customer/Supplier's transactions to a specific ledger account.
// ---------------------------------------------------------------------------

model Account {
  id              String      @id @default(uuid())
  organizationId  String
  code            String // user-assigned, e.g. "1000" - unique per org
  nameEn          String
  nameAr          String?
  accountType     AccountType
  parentAccountId String?
  // Seeded defaults (Cash, Accounts Receivable, VAT Payable, ...) created at org registration -
  // not user-deletable, matching how PERMISSIONS/PLAN_DEFS catalogs are treated as fixed seeds.
  isSystemAccount Boolean     @default(false)
  openingBalance  Decimal     @default(0) @db.Decimal(14, 2)
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parentAccount  Account?        @relation("AccountHierarchy", fields: [parentAccountId], references: [id])
  childAccounts  Account[]       @relation("AccountHierarchy")
  journalLines   JournalLine[]
  customers      Customer[]
  suppliers      Supplier[]
  customerGroups CustomerGroup[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([parentAccountId])
}

model JournalEntry {
  id             String    @id @default(uuid())
  organizationId String
  entryDate      DateTime
  reference      String?
  memo           String?
  createdBy      String
  // null = draft (editable/deletable); once set, the entry is immutable - correct it with a
  // reversing entry via reverse(), never by editing a posted entry. This is the actual
  // bookkeeping guarantee the "full system of record" scope decision asked for.
  postedAt       DateTime?
  reversalOfId   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reversalOf   JournalEntry?  @relation("JournalReversal", fields: [reversalOfId], references: [id])
  reversedBy   JournalEntry[] @relation("JournalReversal")
  lines        JournalLine[]

  @@index([organizationId, entryDate])
}

model JournalLine {
  id             String  @id @default(uuid())
  journalEntryId String
  accountId      String
  // Exactly one of debit/credit is non-zero per line - enforced in journalEntry.service.ts's
  // create(), not at the DB level (Postgres can't easily check a cross-row entry-level balance
  // constraint declaratively).
  debit          Decimal @default(0) @db.Decimal(14, 2)
  credit         Decimal @default(0) @db.Decimal(14, 2)
  memo           String?

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
}

// ---------------------------------------------------------------------------
// Payment Accounts - the EJADA reference's own `accounts`/`account_types`/`account_transactions`
// module (AccountController / AccountReportsController). Deliberately SEPARATE from the
// double-entry Account/JournalEntry ledger above: these are money-holding accounts (cash drawer,
// bank, cheques) with single-sided credit/debit movements, where balance = credits - debits -
// exactly the reference's `SUM(IF(type='credit', amount, -amount))`.
// ---------------------------------------------------------------------------

// Reference's user-defined `account_types` (two levels: a type and its sub-types).
model PaymentAccountType {
  id                  String   @id @default(uuid())
  organizationId      String
  name                String
  parentAccountTypeId String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       PaymentAccountType?  @relation("PaymentAccountTypeTree", fields: [parentAccountTypeId], references: [id], onDelete: Cascade)
  subTypes     PaymentAccountType[] @relation("PaymentAccountTypeTree")
  accounts     PaymentAccount[]

  @@index([organizationId])
}

// Reference's own `type` radio on the account form (Bank Account / Cash / Cheque) - Fund Transfer
// only ever offers BANK accounts as the destination, matching AccountController@getFundTransfer.
enum PaymentAccountKind {
  BANK
  CASH
  CHEQUE
}

model PaymentAccount {
  id             String             @id @default(uuid())
  organizationId String
  name           String
  accountNumber  String
  kind           PaymentAccountKind @default(BANK)
  accountTypeId  String?
  // Reference's six free label/value rows (`account_details[i][label|value]`), stored as-is.
  accountDetails Json?
  note           String?
  isClosed       Boolean            @default(false)
  isMajor        Boolean            @default(false) // reference's own "Major account" checkbox
  createdBy      String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization     Organization                     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accountType      PaymentAccountType?              @relation(fields: [accountTypeId], references: [id], onDelete: SetNull)
  createdByUser    User                             @relation(fields: [createdBy], references: [id])
  transactions     PaymentAccountTransaction[]
  payments         Payment[]
  expenses         Expense[]
  purchases        Purchase[]
  locationDefaults BusinessLocationPaymentAccount[]

  @@index([organizationId])
}

enum PaymentAccountTxnType {
  DEBIT
  CREDIT
}

// Reference's `sub_type` - null for a movement driven by a document's payment (sale/expense/purchase).
enum PaymentAccountTxnSubType {
  OPENING_BALANCE
  DEPOSIT
  FUND_TRANSFER
}

model PaymentAccountTransaction {
  id               String                    @id @default(uuid())
  paymentAccountId String
  type             PaymentAccountTxnType
  subType          PaymentAccountTxnSubType?
  amount           Decimal                   @db.Decimal(14, 2)
  operationDate    DateTime                  @default(now())
  note             String?
  referenceNo      String? // fund transfer's own "CN/Ref No" field
  createdBy        String
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  // At most one of these is set - the document whose payment this movement mirrors.
  paymentId  String? @unique
  expenseId  String? @unique
  purchaseId String? @unique

  // Deposit/fund-transfer legs point at each other (reference's transfer_transaction_id).
  transferTransactionId String?                    @unique
  transferTransaction   PaymentAccountTransaction? @relation("PaymentAccountTransfer", fields: [transferTransactionId], references: [id], onDelete: SetNull)
  transferredFrom       PaymentAccountTransaction? @relation("PaymentAccountTransfer")

  paymentAccount PaymentAccount @relation(fields: [paymentAccountId], references: [id], onDelete: Cascade)
  createdByUser  User           @relation(fields: [createdBy], references: [id])
  payment        Payment?       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  expense        Expense?       @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  purchase       Purchase?      @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([paymentAccountId, operationDate])
}

// Reference's per-location `default_payment_accounts` JSON (Business Location > Payment Options):
// which payment account a payment of a given method at a given branch is credited to by default.
// Also drives the reference's location scoping of the account list/reports for branch-restricted users.
model BusinessLocationPaymentAccount {
  id                 String @id @default(uuid())
  businessLocationId String
  paymentMethodId    String
  paymentAccountId   String

  businessLocation BusinessLocation @relation(fields: [businessLocationId], references: [id], onDelete: Cascade)
  paymentMethod    PaymentMethod    @relation(fields: [paymentMethodId], references: [id], onDelete: Cascade)
  paymentAccount   PaymentAccount   @relation(fields: [paymentAccountId], references: [id], onDelete: Cascade)

  @@unique([businessLocationId, paymentMethodId])
  @@index([paymentAccountId])
}

model Customer {
  id                     String                 @id @default(uuid())
  organizationId         String
  code                   String
  // nameEn is always populated (required everywhere else - invoices, sales, receipts) even
  // though the reference's own `name` is genuinely blank for a "business" contact - same
  // conversion approach as Supplier (see its schema comment): contactType/prefix/first/middle/
  // last mirror the reference's Individual/Business radio exactly, nameEn is computed/kept in
  // sync rather than being a second, independently-typed field.
  nameEn                 String
  nameAr                 String?
  contactType            String                 @default("individual") // "individual" | "business"
  prefix                 String? // individual-only: Mr / Mrs / Miss
  firstName              String? // individual-only
  middleName             String? // individual-only
  lastName               String? // individual-only
  dateOfBirth            DateTime? // individual-only
  businessName           String? // business-only; nameEn mirrors this when contactType is "business"
  phone                  String
  altPhone               String?
  landline               String?
  email                  String?
  customerGroupId        String?
  businessLocationId     String?
  priceListId            String? // wins over the customer group's price list when both are set
  // The reference's "Account" contact field - routes this customer's transactions to a Chart of
  // Accounts entry. Purely a reference/routing field in Phase 1 (no automatic posting reads it
  // yet - see schema.prisma's JournalEntry comment for the Phase 2 scope).
  defaultAccountId       String?
  // The reference's "Invoice Layout for Sale" contact field - a named layout from the
  // InvoiceLayoutSettings catalog, used instead of the business location's own isDefault layout
  // when this customer's invoices are rendered (see sale.service.ts's getById() resolution).
  // Customer-only in the reference - Supplier does not get this field.
  defaultInvoiceLayoutId String?
  address                String?
  addressLine2           String?
  // Reference's own genuinely SEPARATE `shipping_address` text field on Contact (not derived from
  // the structured address fields above) - shown as its own block on Add Sale's customer header,
  // distinct from the computed "Billing Address" display. Free text, matching the reference's own
  // unstructured field exactly (no street/city/etc. breakdown).
  shippingAddress        String?
  country                String?
  state                  String?
  city                   String?
  district               String?
  postalCode             String?
  buildingNo             String? // Saudi National Address field
  additionalNo           String? // Saudi National Address field
  idType                 String? // reference's "other_id": TIN/CRN/MOM/MLS/700/SAG/NAT/IQA/PAS/OTH
  mapLocation            String? // free-text "lat,lng", no map picker built
  vatNumber              String?
  crNumber               String?
  nationalAddress        String?
  notes                  String?
  creditLimit            Decimal                @default(0) @db.Decimal(12, 2)
  paymentTermsDays       Int                    @default(0)
  payTermType            PayTermType?
  openingBalance         Decimal                @default(0) @db.Decimal(12, 2)
  balance                Decimal                @default(0) @db.Decimal(12, 2) // positive = customer owes us
  rewardPoints           Int                    @default(0) // loyalty points balance - see LoyaltyTransaction for the earn/redeem ledger
  cashBack               Decimal                @default(0) @db.Decimal(12, 2) // separate from rewardPoints (P8-2) - see CashbackTransaction for the grant/redeem ledger
  approvalStatus         CustomerApprovalStatus @default(APPROVED) // P8-3 - only ever starts PENDING when Organization.customerApprovalRequired is on
  // Converted from the reference's checkboxes - see Supplier.globalCustomer's comment for why
  // these are saved faithfully but currently have no downstream effect in this app.
  globalCustomer         Boolean                @default(false)
  allowExpeditedDiscount Boolean                @default(false)
  // Generic per-organization custom fields, shared label config with Supplier (Organization's
  // contactCustomFieldNLabel) - see reference's shared `custom_labels['contact']` config.
  customField1           String?
  customField2           String?
  customField3           String?
  customField4           String?
  customField5           String?
  customField6           String?
  customField7           String?
  customField8           String?
  customField9           String?
  customField10          String?
  status                 UserStatus             @default(ACTIVE)
  createdBy              String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  deletedAt              DateTime?

  organization         Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerGroup        CustomerGroup?          @relation(fields: [customerGroupId], references: [id])
  businessLocation     BusinessLocation?       @relation(fields: [businessLocationId], references: [id])
  priceList            PriceList?              @relation(fields: [priceListId], references: [id])
  defaultAccount       Account?                @relation(fields: [defaultAccountId], references: [id])
  defaultInvoiceLayout InvoiceLayoutSettings?  @relation(fields: [defaultInvoiceLayoutId], references: [id])
  contactPersons       CustomerContactPerson[]
  sales                Sale[]
  payments             Payment[]
  heldSales            HeldSale[]
  compensations        Compensation[]
  loyaltyTransactions  LoyaltyTransaction[]
  cashbackTransactions CashbackTransaction[]
  bookings             Booking[]
  sellReturns          SellReturn[]
  coupons              Coupon[]
  userRestrictions     UserCustomer[]
  bnplSessions         BnplSession[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([phone])
  @@index([nameEn])
  @@index([status])
}

// Mirrors SupplierContactPerson exactly - see its comment for why the reference's "Allow login"
// portal-account fields aren't replicated (no customer/supplier self-service portal exists here).
model CustomerContactPerson {
  id                  String   @id @default(uuid())
  customerId          String
  prefix              String?
  firstName           String
  lastName            String?
  email               String?
  mobile              String?
  altPhone            String?
  familyContactNumber String?
  department          String?
  designation         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

// ---------------------------------------------------------------------------
// Product master data
// ---------------------------------------------------------------------------

model Category {
  id             String     @id @default(uuid())
  organizationId String
  nameEn         String
  nameAr         String
  code           String?
  descriptionEn  String?
  descriptionAr  String?
  parentId       String?
  status         UserStatus @default(ACTIVE)
  // Reference's category `target` / `target_mtd` (taxonomy form, laundry mode): the main
  // category's yearly and monthly sales targets, read by Sales Reports > Sales Performance.
  target         Decimal?   @db.Decimal(14, 2)
  targetMtd      Decimal?   @db.Decimal(14, 2)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       Category?    @relation("CategoryToParent", fields: [parentId], references: [id])
  children     Category[]   @relation("CategoryToParent")
  products     Product[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model Brand {
  id             String     @id @default(uuid())
  organizationId String
  nameEn         String
  nameAr         String
  description    String?
  status         UserStatus @default(ACTIVE)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]

  @@index([organizationId])
}

model Unit {
  id              String     @id @default(uuid())
  organizationId  String
  nameEn          String
  nameAr          String
  shortName       String
  baseUnitId      String?
  conversionRatio Decimal    @default(1) @db.Decimal(12, 4)
  status          UserStatus @default(ACTIVE)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  baseUnit     Unit?        @relation("UnitToBase", fields: [baseUnitId], references: [id])
  subUnits     Unit[]       @relation("UnitToBase")
  products     Product[]
  services     Service[]

  @@index([organizationId])
}

model Tax {
  id             String          @id @default(uuid())
  organizationId String
  nameEn         String
  nameAr         String
  percentage     Decimal         @db.Decimal(5, 2)
  taxType        String          @default("VAT")
  categoryCode   TaxCategoryCode @default(S) // ZATCA UBL tax category code
  isActive       Boolean         @default(true)
  effectiveDate  DateTime        @default(now())
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]
  services     Service[]

  @@index([organizationId])
}

model Product {
  id                  String      @id @default(uuid())
  organizationId      String
  nameEn              String
  nameAr              String
  sku                 String
  barcodeType         String      @default("CODE128")
  barcode             String?
  brandId             String?
  unitId              String
  categoryId          String?
  descriptionEn       String?
  descriptionAr       String?
  image               String?
  productType         ProductType @default(STANDARD)
  manageStock         Boolean     @default(true)
  alertQuantity       Decimal?    @db.Decimal(12, 3)
  taxId               String?
  sellingPriceTaxType TaxType     @default(EXCLUSIVE)
  purchasePrice       Decimal     @default(0) @db.Decimal(12, 2)
  sellingPrice        Decimal     @db.Decimal(12, 2)
  status              UserStatus  @default(ACTIVE)
  createdBy           String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  deletedAt           DateTime?

  organization         Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand                Brand?                    @relation(fields: [brandId], references: [id])
  unit                 Unit                      @relation(fields: [unitId], references: [id])
  category             Category?                 @relation(fields: [categoryId], references: [id])
  tax                  Tax?                      @relation(fields: [taxId], references: [id])
  businessLocations    ProductBusinessLocation[]
  stocks               ProductStock[]
  saleItems            SaleItem[]
  inventoryTxns        InventoryTransaction[]
  heldSaleItems        HeldSaleItem[]
  priceListItems       PriceListItem[]
  purchaseItems        PurchaseItem[]
  stockTransfers       StockTransfer[]
  stockAdjustmentItems StockAdjustmentItem[]

  @@unique([organizationId, sku])
  @@unique([organizationId, barcode])
  @@index([organizationId])
  @@index([nameEn])
  @@index([status])
}

model ProductBusinessLocation {
  productId          String
  businessLocationId String
  product            Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  businessLocation   BusinessLocation @relation(fields: [businessLocationId], references: [id], onDelete: Cascade)

  @@id([productId, businessLocationId])
}

model ProductStock {
  id                 String   @id @default(uuid())
  productId          String
  businessLocationId String
  quantity           Decimal  @default(0) @db.Decimal(12, 3)
  updatedAt          DateTime @updatedAt

  product          Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  businessLocation BusinessLocation @relation(fields: [businessLocationId], references: [id], onDelete: Cascade)

  @@unique([productId, businessLocationId])
}

model InventoryTransaction {
  id                 String                   @id @default(uuid())
  productId          String
  businessLocationId String
  type               InventoryTransactionType
  quantity           Decimal                  @db.Decimal(12, 3) // signed: + increases stock, - decreases
  balanceAfter       Decimal                  @db.Decimal(12, 3)
  referenceType      String? // e.g. "SALE", "ADJUSTMENT"
  referenceId        String?
  note               String?
  createdBy          String?
  createdAt          DateTime                 @default(now())

  product          Product          @relation(fields: [productId], references: [id])
  businessLocation BusinessLocation @relation(fields: [businessLocationId], references: [id])
  createdByUser    User?            @relation(fields: [createdBy], references: [id])

  @@index([productId])
  @@index([businessLocationId])
  @@index([createdAt])
}

enum StockTransferStatus {
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

// Two-step transfer (P6-5): shipping decrements the source immediately and creates this row as
// IN_TRANSIT; destination stock is untouched until a separate receive step confirms the actual
// quantity received (which may differ from what was sent) and moves the row to RECEIVED.
model StockTransfer {
  id                     String              @id @default(uuid())
  organizationId         String
  productId              String
  fromBusinessLocationId String
  toBusinessLocationId   String
  quantitySent           Decimal             @db.Decimal(12, 3)
  quantityReceived       Decimal?            @db.Decimal(12, 3)
  status                 StockTransferStatus @default(IN_TRANSIT)
  driverName             String?
  vehicleNumber          String?
  shipNote               String?
  receiveNote            String?
  createdBy              String
  shippedAt              DateTime            @default(now())
  receivedAt             DateTime?
  receivedBy             String?

  organization         Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product              Product          @relation(fields: [productId], references: [id])
  fromBusinessLocation BusinessLocation @relation("StockTransferFrom", fields: [fromBusinessLocationId], references: [id])
  toBusinessLocation   BusinessLocation @relation("StockTransferTo", fields: [toBusinessLocationId], references: [id])
  createdByUser        User             @relation("StockTransferCreatedBy", fields: [createdBy], references: [id])
  receivedByUser       User?            @relation("StockTransferReceivedBy", fields: [receivedBy], references: [id])

  @@index([organizationId])
  @@index([status])
  @@index([toBusinessLocationId])
}

enum StockAdjustmentLossType {
  NORMAL
  ABNORMAL
}

enum StockAdjustmentStatus {
  CONFIRMED
  REVERSED
}

// Grouped, multi-line stock adjustment (P8-4) - distinct from the single-product adjustStock()
// above, which stays available for quick one-off corrections. This is for a batch count/write-off
// covering several products at once, with loss classification and an optional cost-recovery
// amount (e.g. insurance or a supplier credit for ABNORMAL/non-routine loss), and a reversal path
// that writes a compensating InventoryTransaction rather than deleting anything - same "never
// delete, only compensate" discipline as StockTransfer's cancelTransfer().
model StockAdjustment {
  id                   String                  @id @default(uuid())
  organizationId       String
  businessLocationId   String
  adjustmentNumber     String? // human-readable, e.g. ADJ-000001 - claimed from BusinessLocation.lastAdjustmentSeq
  refNo                String? // reference's own free-text "Ref No" field (StockAdjustmentController's ref_no) - user's own external reference, distinct from adjustmentNumber
  adjustmentDate       DateTime                @default(now())
  lossType             StockAdjustmentLossType @default(NORMAL)
  totalAmountRecovered Decimal                 @default(0) @db.Decimal(12, 2) // meaningful only when lossType is ABNORMAL
  status               StockAdjustmentStatus   @default(CONFIRMED)
  notes                String?
  createdBy            String
  createdAt            DateTime                @default(now())
  reversedAt           DateTime?

  organization     Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessLocation BusinessLocation      @relation(fields: [businessLocationId], references: [id])
  createdByUser    User                  @relation(fields: [createdBy], references: [id])
  items            StockAdjustmentItem[]

  @@unique([businessLocationId, adjustmentNumber])
  @@index([organizationId])
  @@index([businessLocationId])
}

model StockAdjustmentItem {
  id                String  @id @default(uuid())
  stockAdjustmentId String
  productId         String
  quantityChange    Decimal @db.Decimal(12, 3) // signed: + increases stock, - decreases
  note              String?

  stockAdjustment StockAdjustment @relation(fields: [stockAdjustmentId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id])

  @@index([stockAdjustmentId])
  @@index([productId])
}

