model ServiceBusinessLocation {
  serviceId          String
  businessLocationId String
  service            Service          @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  businessLocation   BusinessLocation @relation(fields: [businessLocationId], references: [id], onDelete: Cascade)

  @@id([serviceId, businessLocationId])
}

// ---------------------------------------------------------------------------
// Sales / POS
// ---------------------------------------------------------------------------

model PaymentMethod {
  id             String  @id @default(uuid())
  organizationId String
  nameEn         String
  nameAr         String
  code           String // CASH, CARD, ONLINE
  isActive       Boolean @default(true)

  organization     Organization                     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payments         Payment[]
  locationAccounts BusinessLocationPaymentAccount[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

// BNPL (Buy Now Pay Later): Tamara/Tabby/MISPay. No real merchant credentials exist yet for any
// provider - see backend/src/modules/bnpl/bnplGateway.ts, whose "real" branch is a clearly-marked
// stub until credentials are configured. Each provider is its own PaymentMethod code
// (BNPL_TAMARA/BNPL_TABBY/BNPL_MISPAY) so the payment-method breakdown report shows per-provider
// volume, same as CASH/CARD/CASHBACK today.
enum BnplProvider {
  TAMARA
  TABBY
  MISPAY
}

// CREATED (session opened with the provider) -> APPROVED (customer approved on their phone) ->
// CAPTURED (funds confirmed, safe to ride as a Payment on the sale). The frontend auto-fires the
// capture call the instant it observes APPROVED via polling - no cashier click - but the service
// layer still re-verifies with the gateway before every status transition, never trusting the
// client's view of the world (same discipline as billing.service.ts verifyPayment()).
enum BnplSessionStatus {
  CREATED
  APPROVED
  CAPTURED
  FAILED
  CANCELLED
  EXPIRED
}

// Per-org, per-provider merchant configuration. merchantTokenEncrypted follows the same
// secretBox.ts AES-256-GCM pattern as NotificationSettings.appSidEncrypted - the plaintext is
// never returned to the frontend, only a hasMerchantToken boolean.
model BnplProviderSettings {
  id                     String       @id @default(uuid())
  organizationId         String
  provider               BnplProvider
  isEnabled              Boolean      @default(false)
  merchantTokenEncrypted String?      @db.Text
  apiBaseUrlOverride     String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
  @@index([organizationId])
}

// One BNPL checkout attempt. saleId is set only once verifyAndConsumeSessionTx() has consumed it
// inside the same transaction as the sale's Payment row - the @unique constraint below is what
// makes a session usable exactly once, even under concurrent checkout attempts.
model BnplSession {
  id                 String            @id @default(uuid())
  organizationId     String
  businessLocationId String
  provider           BnplProvider
  providerSessionId  String
  status             BnplSessionStatus @default(CREATED)
  amount             Decimal           @db.Decimal(12, 2)
  currency           String            @default("SAR")
  customerId         String
  customerPhone      String
  checkoutUrl        String?           @db.Text
  saleId             String?           @unique
  rawLastResponse    Json?
  failureReason      String?
  expiresAt          DateTime
  createdBy          String
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessLocation BusinessLocation @relation(fields: [businessLocationId], references: [id])
  customer         Customer         @relation(fields: [customerId], references: [id])
  sale             Sale?            @relation(fields: [saleId], references: [id])
  createdByUser    User             @relation(fields: [createdBy], references: [id])

  @@index([organizationId, status])
  @@index([businessLocationId])
}

model Sale {
  id                 String        @id @default(uuid()) // also serves as the ZATCA invoice UUID (cbc:UUID)
  organizationId     String
  invoiceNumber      String? // human-readable, e.g. INV-000001 - NOT the ZATCA ICV. Null on a DRAFT quote until confirmQuote() assigns it.
  quoteNumber        String? // e.g. QT-000001 - set only on a DRAFT quote (or a sale later confirmed from one); separate sequence from invoiceNumber
  // Reference's own lazily-generated `invoice_token` (Util::getInvoiceUrl()) - powers the
  // action-dropdown's "View Quote URL" (quotation-only, per the reference's `sub_status ==
  // "quotation"` check): a public, unauthenticated link a customer can open with no login, built
  // from this random token rather than the Sale's own id so the id itself never has to be exposed.
  // Null until the first time a share link is requested (pos.service.ts's getOrCreateShareToken()).
  publicToken        String?       @unique
  // Reference's own `is_quotation` flag - distinguishes the SAME status=DRAFT sale between its two
  // real sub-types: a price Quotation (isQuotation=true, numbered via quoteNumber) and a "Delivery"
  // (isQuotation=false, numbered via deliveryNumber below) - the laundry intake/drop-off ticket the
  // reference's own "Add Delivery" screen creates. Defaults true so every pre-existing DRAFT row
  // (all created through the quote flow, before this field existed) keeps reading as a quote.
  isQuotation        Boolean       @default(true)
  deliveryNumber     String? // e.g. DFT-000001 - set only when isQuotation=false; separate sequence from quoteNumber/invoiceNumber
  businessLocationId String
  customerId         String
  // Reference's `transactions.customer_group_id` - the customer's group stamped onto the sale at
  // the time it was made, so moving a customer to another group later doesn't rewrite the
  // Companies / Detailed Companies reports for their past invoices.
  customerGroupId    String?
  saleDate           DateTime      @default(now())
  estimatedReadyAt   DateTime? // max(estimatedProcessingHours) across service lines, from saleDate - null if no service line has one
  status             SaleStatus    @default(FINAL)
  paymentStatus      PaymentStatus @default(DUE)
  saleType           SaleType? // PRODUCT / SERVICE / MIXED, derived from item composition at checkout - see SaleType
  channel            SaleChannel   @default(POS) // which frontend rang this up - POS (touch-grid) or ADD_SALE (back-office table screen) - see SaleChannel
  subtotal           Decimal       @db.Decimal(12, 2)
  discountAmount     Decimal       @default(0) @db.Decimal(12, 2)
  taxAmount          Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount        Decimal       @db.Decimal(12, 2)
  paidAmount         Decimal       @default(0) @db.Decimal(12, 2)
  dueAmount          Decimal       @default(0) @db.Decimal(12, 2)
  lastReminderSentAt DateTime? // last time paymentReminder.job.ts sent a PAYMENT_REMINDER SMS for this invoice
  notes              String?
  createdBy          String
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  cancelledAt        DateTime?

  // Reference's own `import_batch`/`import_time` on `transactions` (ImportSalesController) - set
  // only on a sale bulk-loaded via List/Import Sales, null for every normal POS/Add Sale checkout.
  // Groups an import run for the history list + "revert this batch" action; a per-organization
  // sequential counter (max(importBatch)+1), not per-location, matching the reference's own
  // per-business numbering since one uploaded file can span multiple branches.
  importBatch Int?
  importedAt  DateTime?

  registerSessionId     String? // which cashier session this sale was rung up under, if one was open
  couponId              String?
  couponDiscountAmount  Decimal @default(0) @db.Decimal(12, 2) // server-computed - never trust a client-sent discount
  invoiceDiscountAmount Decimal @default(0) @db.Decimal(12, 2) // server-computed manual cashier discount (fixed or %), separate from couponDiscountAmount
  shippingAmount        Decimal @default(0) @db.Decimal(12, 2) // flat delivery/handling charge, taxed at the invoice's effective VAT rate like the rest of subtotal

  // --- Sale custom fields - reference's own `custom_field_1..4` on a direct sale, org-labeled via
  // Organization.sellCustomFieldNLabel above. Free text, no downstream effect beyond display/export
  // (same as the Contact custom fields) - purely for the business's own record-keeping. ---
  customField1 String?
  customField2 String?
  customField3 String?
  customField4 String?

  // --- Additional expenses - reference's own 4 fixed named key/value expense slots (not a
  // dynamic list - matches the reference's literal `additional_expense_key_1..4`/`_value_1..4`
  // shape exactly). Deliberately UNTAXED flat pass-through charges added straight to totalAmount
  // (unlike shippingAmount above, which IS taxed) - matches how this kind of ad hoc reimbursable
  // charge (a permit fee, a rush surcharge already inclusive, ...) is normally invoiced, and keeps
  // the existing tax-calculation pipeline (subtotal -> tax -> total) untouched. ---
  additionalExpense1Key   String?
  additionalExpense1Value Decimal @default(0) @db.Decimal(12, 2)
  additionalExpense2Key   String?
  additionalExpense2Value Decimal @default(0) @db.Decimal(12, 2)
  additionalExpense3Key   String?
  additionalExpense3Value Decimal @default(0) @db.Decimal(12, 2)
  additionalExpense4Key   String?
  additionalExpense4Value Decimal @default(0) @db.Decimal(12, 2)

  // --- ZATCA tax exemption reason - only meaningful when the invoice's effective tax category is
  // Exempt/Zero-rated (see zatca/xmlGenerator.service.ts's cac:TaxExemptionReasonCode) - one of
  // ZATCA's own fixed VATEX-SA-* codes, stored as plain text since there's no local table of them. ---
  taxExemptionReasonCode String?

  // --- Add Sale header fields (reference's own `sell/create.blade.php`, distinct from the
  // touch-grid POS screen - see pos.service.ts's checkout() comment on how these are resolved). ---
  // Per-sale Selling Price Group override - recorded here (not just used transiently) so a report
  // or a later edit can see which price list actually priced this specific invoice, same as the
  // reference's own `selling_price_group_id` column. Null means the customer/location default was
  // used, unchanged from every prior round's behavior.
  priceListId          String?
  // Pay Term entered on Add Sale (pre-filled from the customer's own configured term, but
  // independently editable per-invoice, matching the reference's `pay_term_number`/`pay_term_type`
  // fields) - used only to compute dueDate below; does not alter the customer's own stored term.
  payTermNumber        Int?
  payTermType          PayTermType?
  // Reference's own `sell_due_date` - computed client-side from payTermNumber/payTermType against
  // saleDate and sent as one concrete date, not recomputed server-side from the two parts (matches
  // the reference's own store()-time behavior exactly). Null when no pay term was set.
  dueDate              DateTime?
  // Reference's own "Attach Document" upload (`sell_document`, max 9MB, pdf/csv/zip/doc/docx/
  // jpeg/jpg/png) - uploaded separately via POST /sales/documents BEFORE checkout (this endpoint
  // is plain JSON, not multipart), then referenced here by the path that upload returned. See
  // pos.service.ts checkout()'s validation that the path's org segment actually matches the
  // caller's organizationId before it's trusted. documentOriginalName is the user's own filename,
  // kept separately from the randomized on-disk name for a correct download filename later.
  documentPath         String?
  documentOriginalName String?

  // --- ZATCA (Fatoora) e-invoicing fields - see docs/POS-ZATCA-PLAN.md Phase A/B/C ---
  // All null on a DRAFT quote - the whole ZATCA pipeline (ICV claim, hash chain, signing) only
  // runs once confirmQuote() promotes the quote to a real FINAL invoice.
  icv                 Int? // sequential Invoice Counter Value, unique per business location
  previousInvoiceHash String? // PIH - hash of the prior invoice in this location's chain ("MA==" / base64("0") for the first)
  invoiceHash         String? // hash of this invoice's canonical content (XML-based once a signing key exists, else Phase A's JSON fallback)
  invoiceTypeCode     ZatcaInvoiceType     @default(SIMPLIFIED) // STANDARD (B2B, needs Clearance) vs SIMPLIFIED (B2C, needs Reporting)
  transactionTypeCode ZatcaTransactionType @default(INVOICE)
  qrCodeBase64        String? // TLV Base64 QR payload - 5 or 8 fields depending on whether this invoice was signed
  clearanceStatus     ZatcaClearanceStatus @default(NOT_SUBMITTED)
  xmlContent          String?              @db.Text // canonical UBL 2.1 XML, only set once a signing key exists (Phase C)
  digitalSignature    String?              @db.Text // ECDSA signature over the invoice hash, base64
  publicKeyPem        String?              @db.Text // signer's public key at time of signing (for QR field 8 / later verification)
  zatcaSubmittedAt    DateTime? // when we last called Clearance/Reporting for this invoice (Phase D)
  zatcaResponseRaw    Json? // full raw response from ZATCA's Clearance/Reporting API, for audit

  organization         Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessLocation     BusinessLocation       @relation(fields: [businessLocationId], references: [id])
  customer             Customer               @relation(fields: [customerId], references: [id])
  customerGroup        CustomerGroup?         @relation(fields: [customerGroupId], references: [id], onDelete: SetNull)
  createdByUser        User                   @relation(fields: [createdBy], references: [id])
  registerSession      RegisterSession?       @relation(fields: [registerSessionId], references: [id])
  coupon               Coupon?                @relation(fields: [couponId], references: [id])
  priceList            PriceList?             @relation(fields: [priceListId], references: [id])
  items                SaleItem[]
  payments             Payment[]
  compensations        Compensation[]
  loyaltyTransactions  LoyaltyTransaction[]
  cashbackTransactions CashbackTransaction[]
  sellReturns          SellReturn[]
  bnplSession          BnplSession?
  inventoryPostings    InventoryPostingSale[]

  // Scoped to the branch, not the org - invoiceNumber/quoteNumber are now claimed from a
  // per-BusinessLocation counter (P7-5), so two different branches can legitimately produce the
  // same number (e.g. both branches' first invoice is "INV-000001").
  @@unique([businessLocationId, invoiceNumber])
  @@unique([businessLocationId, quoteNumber])
  @@unique([businessLocationId, icv])
  @@index([organizationId])
  @@index([businessLocationId])
  @@index([customerId])
  @@index([saleDate])
  @@index([status])
  @@index([paymentStatus])
  @@index([organizationId, importBatch])
  @@index([customerGroupId])
}

model SaleItem {
  id                String                @id @default(uuid())
  saleId            String
  productId         String?
  serviceId         String?
  descriptionEn     String
  descriptionAr     String?
  quantity          Decimal               @db.Decimal(12, 3)
  unitPrice         Decimal               @db.Decimal(12, 2)
  taxPercent        Decimal               @default(0) @db.Decimal(5, 2)
  taxAmount         Decimal               @default(0) @db.Decimal(12, 2)
  discountAmount    Decimal               @default(0) @db.Decimal(12, 2)
  subtotal          Decimal               @db.Decimal(12, 2) // (qty * unitPrice) - discount, excl. tax
  total             Decimal               @db.Decimal(12, 2) // subtotal + tax
  taxCategoryCode   String                @default("S") // ZATCA UBL tax category (S/Z/E/...) - persisted so confirmQuote() can rebuild the XML without re-deriving it from the product/service's current tax rate
  fulfillmentStatus ItemFulfillmentStatus @default(PENDING) // per-garment tracking, independent of the invoice's own SaleStatus
  statusUpdatedAt   DateTime?
  // Reference's per-line edit modal (`row_edit_product_price_modal.blade.php`) - a free-text note
  // attached to this one line (distinct from Sale.notes, which is for the whole invoice), and
  // width/height for laundry's own dimension-based pricing (carpets/curtains priced per m² - see
  // pos.service.ts's priceLine(), which multiplies quantity by widthM*heightM when both are set).
  note              String?
  widthM            Decimal?              @db.Decimal(8, 3)
  heightM           Decimal?              @db.Decimal(8, 3)

  sale              Sale                    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product           Product?                @relation(fields: [productId], references: [id])
  service           Service?                @relation(fields: [serviceId], references: [id])
  statusHistory     SaleItemStatusHistory[]
  compensationItems CompensationItem[]
  sellReturnItems   SellReturnItem[]

  @@index([saleId])
  @@index([fulfillmentStatus])
}

// A customer returning goods/services for a refund or credit - distinct from Compensation
// (the shop paying out for its own mistake). Deliberately does NOT mutate the parent Sale: that
// invoice's hash/signature were computed at checkout and must stay exactly as issued, so a
// return lives as its own record referencing the original, the same way a real credit note
// would. `refundedAmount` may be less than `totalAmount` (e.g. store credit instead of cash) -
// the customer balance adjustment nets the two (see sellReturn.service.ts).
model SellReturn {
  id                 String        @id @default(uuid())
  organizationId     String
  saleId             String
  customerId         String
  customerGroupId    String? // copied from the returned sale's own snapshot (see Sale.customerGroupId)
  businessLocationId String
  creditNoteNumber   String? // human-readable, e.g. CN-000001 - claimed from BusinessLocation.lastReturnSeq (P7-5)
  returnDate         DateTime      @default(now())
  subtotal           Decimal       @db.Decimal(12, 2)
  // Return-level discount (reference's own discount_type/discount_amount on the return form),
  // netted into `subtotal` the exact same way Sale.invoiceDiscountAmount is - stores only the
  // resulting amount, not the fixed/percentage mode used to compute it.
  discountAmount     Decimal       @default(0) @db.Decimal(12, 2)
  taxAmount          Decimal       @db.Decimal(12, 2)
  totalAmount        Decimal       @db.Decimal(12, 2)
  refundedAmount     Decimal       @default(0) @db.Decimal(12, 2)
  // Reference's own `payment_status` on a sell_return transaction (has the store actually paid
  // the customer back yet?) - reuses the exact same PaymentStatus enum Sale already uses, computed
  // once at create() time from refundedAmount vs totalAmount (see sellReturn.service.ts). A stored,
  // filterable/indexable column rather than computed-on-read, matching how Sale.paymentStatus
  // already works. OVERPAID is never actually assigned here (refundedAmount is always clamped to
  // totalAmount at creation) but the shared enum keeps this one value technically reachable.
  paymentStatus      PaymentStatus @default(DUE)
  notes              String?
  createdBy          String
  createdAt          DateTime      @default(now())

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sale             Sale             @relation(fields: [saleId], references: [id])
  customer         Customer         @relation(fields: [customerId], references: [id])
  customerGroup    CustomerGroup?   @relation(fields: [customerGroupId], references: [id], onDelete: SetNull)
  businessLocation BusinessLocation @relation(fields: [businessLocationId], references: [id])
  createdByUser    User             @relation(fields: [createdBy], references: [id])
  items            SellReturnItem[]

  @@unique([businessLocationId, creditNoteNumber])
  @@index([organizationId])
  @@index([saleId])
  @@index([customerId])
}

model SellReturnItem {
  id           String           @id @default(uuid())
  sellReturnId String
  saleItemId   String
  quantity     Decimal          @db.Decimal(12, 3)
  unitPrice    Decimal          @db.Decimal(12, 2)
  taxPercent   Decimal          @db.Decimal(5, 2)
  taxAmount    Decimal          @db.Decimal(12, 2)
  subtotal     Decimal          @db.Decimal(12, 2)
  total        Decimal          @db.Decimal(12, 2)
  reason       SellReturnReason
  note         String?

  sellReturn SellReturn @relation(fields: [sellReturnId], references: [id], onDelete: Cascade)
  saleItem   SaleItem   @relation(fields: [saleItemId], references: [id])

  @@index([sellReturnId])
  @@index([saleItemId])
}

// ---------------------------------------------------------------------------
// Suppliers / Purchasing - the reference site tracks suppliers as a Business Partner type
// (Purchase Due / Purchase Return / Advance / Opening Balance columns) and tracks product cost
// at the product level (Product.purchasePrice) rather than through a dedicated purchase-order
// screen - no such screen exists in its nav and the /purchases route 403s even to an admin
// login. A Purchase record here is what actually produces a non-zero "Purchase Due": it receives
// stock from a supplier and increases what the business owes them, mirroring the SellReturn
// pattern used for sales (a PurchaseReturn is the reverse, sending stock back and reducing the
// balance owed).
// ---------------------------------------------------------------------------

model Supplier {
  id                     String       @id @default(uuid())
  organizationId         String
  code                   String // the reference app's "Contact ID" - auto-generated (SUP-00001) but overridable by the user at creation, see supplier.service.ts's create()
  // nameEn is always populated (required everywhere else in the system - invoices, purchase
  // records, ...) even though the reference's own `name` is genuinely blank for a "business"
  // contact. Converted faithfully: contactType/prefix/firstName/middleName/lastName mirror the
  // reference's Individual/Business radio exactly (see SuppliersPage.tsx), and nameEn is kept in
  // sync automatically - composed from prefix+first+middle+last for "individual", mirrored from
  // businessName for "business" - rather than being a second, independently-typed field.
  nameEn                 String
  nameAr                 String?
  contactType            String       @default("individual") // "individual" | "business" - the reference's own value strings
  prefix                 String? // individual-only: Mr / Mrs / Miss
  firstName              String? // individual-only
  middleName             String? // individual-only
  lastName               String? // individual-only
  dateOfBirth            DateTime? // individual-only
  businessName           String? // business-only in the reference; nameEn mirrors this when contactType is "business"
  // Both converted from the reference's checkboxes, but their real downstream effect depends on
  // systems this app doesn't have yet - saved faithfully, not fabricated as fully working:
  // - globalCustomer: in the reference, bypasses a per-location-group visibility restriction on
  //   contact lists. This app has no such restriction at all (every user sees every supplier
  //   org-wide already), so the flag has no behavioral effect yet - only meaningful if/when
  //   location-group-scoped visibility is ever built.
  // - allowExpeditedDiscount: in the reference, gates an early-payment discount (pay within N
  //   days of the transaction -> automatic % off), controlled by org-wide settings
  //   (enable_expedited_payments/days/percent) this app doesn't have either. Same status.
  globalCustomer         Boolean      @default(false)
  allowExpeditedDiscount Boolean      @default(false)
  phone                  String
  altPhone               String?
  landline               String?
  email                  String?
  businessLocationId     String?
  // The reference's "Account" contact field - same as Customer.defaultAccountId, see its comment.
  defaultAccountId       String?
  address                String?
  addressLine2           String?
  country                String?
  state                  String?
  city                   String?
  district               String?
  postalCode             String?
  buildingNo             String? // Saudi National Address field
  additionalNo           String? // Saudi National Address field
  idType                 String? // reference's "other_id": TIN/CRN/MOM/MLS/700/SAG/NAT/IQA/PAS/OTH
  mapLocation            String? // free-text "lat,lng", no map picker built
  shippingAddress        String? // reference's own separate free-text field - see Customer.shippingAddress's comment
  vatNumber              String?
  crNumber               String?
  nationalAddress        String?
  notes                  String?
  creditLimit            Decimal      @default(0) @db.Decimal(12, 2)
  paymentTermsDays       Int          @default(0)
  payTermType            PayTermType?
  openingBalance         Decimal      @default(0) @db.Decimal(12, 2)
  balance                Decimal      @default(0) @db.Decimal(12, 2) // positive = we owe the supplier (Purchase Due)
  // Generic per-organization custom fields, shared label config with Customer (Organization's
  // contactCustomFieldNLabel) - see reference's shared `custom_labels['contact']` config.
  customField1           String?
  customField2           String?
  customField3           String?
  customField4           String?
  customField5           String?
  customField6           String?
  customField7           String?
  customField8           String?
  customField9           String?
  customField10          String?
  status                 UserStatus   @default(ACTIVE)
  createdBy              String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  deletedAt              DateTime?

  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessLocation BusinessLocation?       @relation(fields: [businessLocationId], references: [id])
  defaultAccount   Account?                @relation(fields: [defaultAccountId], references: [id])
  purchases        Purchase[]
  purchaseReturns  PurchaseReturn[]
  expenses         Expense[]
  contactPersons   SupplierContactPerson[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([phone])
  @@index([nameEn])
  @@index([status])
}

// The reference's "Add Contact Persons" repeatable sub-form. There, a contact person is only
// ever persisted as a portal-login `User` row (crm_contact_id FK) and is silently discarded
// entirely if "Allow login" isn't checked with a username/password - this system has no
// customer/supplier self-service portal or auth for external contacts at all, so that mechanic
// is deliberately NOT replicated. Every contact person here is just an information record,
// always saved regardless of login fields (which don't exist). Also deliberately unlimited
// (add/remove rows) rather than the reference's hardcoded 3-slot UI.
model SupplierContactPerson {
  id                  String   @id @default(uuid())
  supplierId          String
  prefix              String?
  firstName           String
  lastName            String?
  email               String?
  mobile              String?
  altPhone            String?
  familyContactNumber String?
  department          String?
  designation         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
}

model Purchase {
  id                 String         @id @default(uuid())
  organizationId     String
  referenceNumber    String // human-readable, e.g. PUR-000001
  supplierId         String
  businessLocationId String
  purchaseDate       DateTime       @default(now())
  status             PurchaseStatus @default(RECEIVED)
  subtotal           Decimal        @db.Decimal(12, 2)
  taxAmount          Decimal        @default(0) @db.Decimal(12, 2)
  totalAmount        Decimal        @db.Decimal(12, 2)
  paidAmount         Decimal        @default(0) @db.Decimal(12, 2)
  paymentAccountId   String? // reference's purchase payment `account_id` - debited by paidAmount
  notes              String?
  createdBy          String
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  organization              Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier                  Supplier                   @relation(fields: [supplierId], references: [id])
  businessLocation          BusinessLocation           @relation(fields: [businessLocationId], references: [id])
  createdByUser             User                       @relation(fields: [createdBy], references: [id])
  items                     PurchaseItem[]
  purchaseReturns           PurchaseReturn[]
  paymentAccount            PaymentAccount?            @relation(fields: [paymentAccountId], references: [id], onDelete: SetNull)
  paymentAccountTransaction PaymentAccountTransaction?

  @@unique([organizationId, referenceNumber])
  @@index([organizationId])
  @@index([supplierId])
  @@index([businessLocationId])
}

model PurchaseItem {
  id         String  @id @default(uuid())
  purchaseId String
  productId  String
  quantity   Decimal @db.Decimal(12, 3)
  unitCost   Decimal @db.Decimal(12, 2)
  taxPercent Decimal @default(0) @db.Decimal(5, 2)
  taxAmount  Decimal @default(0) @db.Decimal(12, 2)
  subtotal   Decimal @db.Decimal(12, 2)
  total      Decimal @db.Decimal(12, 2)

  purchase            Purchase             @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product             Product              @relation(fields: [productId], references: [id])
  purchaseReturnItems PurchaseReturnItem[]

  @@index([purchaseId])
  @@index([productId])
}

model PurchaseReturn {
  id                 String   @id @default(uuid())
  organizationId     String
  purchaseId         String
  supplierId         String
  businessLocationId String
  returnDate         DateTime @default(now())
  subtotal           Decimal  @db.Decimal(12, 2)
  taxAmount          Decimal  @db.Decimal(12, 2)
  totalAmount        Decimal  @db.Decimal(12, 2)
  refundedAmount     Decimal  @default(0) @db.Decimal(12, 2)
  notes              String?
  createdBy          String
  createdAt          DateTime @default(now())

  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchase         Purchase             @relation(fields: [purchaseId], references: [id])
  supplier         Supplier             @relation(fields: [supplierId], references: [id])
  businessLocation BusinessLocation     @relation(fields: [businessLocationId], references: [id])
  createdByUser    User                 @relation(fields: [createdBy], references: [id])
  items            PurchaseReturnItem[]

  @@index([organizationId])
  @@index([purchaseId])
  @@index([supplierId])
}

model PurchaseReturnItem {
  id               String               @id @default(uuid())
  purchaseReturnId String
  purchaseItemId   String
  quantity         Decimal              @db.Decimal(12, 3)
  unitCost         Decimal              @db.Decimal(12, 2)
  taxPercent       Decimal              @db.Decimal(5, 2)
  taxAmount        Decimal              @db.Decimal(12, 2)
  subtotal         Decimal              @db.Decimal(12, 2)
  total            Decimal              @db.Decimal(12, 2)
  reason           PurchaseReturnReason
  note             String?

  purchaseReturn PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  purchaseItem   PurchaseItem   @relation(fields: [purchaseItemId], references: [id])

  @@index([purchaseReturnId])
  @@index([purchaseItemId])
}

// Flat taxonomy for Expense (P8-1) - mirrors ServiceCategory's shape exactly (bilingual name,
// optional description, org-scoped, no budget/target fields or hierarchy).
model ExpenseCategory {
  id             String     @id @default(uuid())
  organizationId String
  nameEn         String
  nameAr         String
  code           String?
  description    String?
  status         UserStatus @default(ACTIVE)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expenses     Expense[]

  @@index([organizationId])
}

// A categorized, taxed, optionally-recurring outflow (P8-1) - modeled on Purchase's shape
// (single supplier, flat paidAmount, no Payment sub-table) but using Sale's due/partial/paid
// PaymentStatus lifecycle, since Purchase itself has no paymentStatus field.
model Expense {
  id                    String        @id @default(uuid())
  organizationId        String
  expenseNumber         String? // human-readable, e.g. EXP-000001 - claimed from BusinessLocation.lastExpenseSeq
  categoryId            String
  businessLocationId    String
  supplierId            String?
  expenseDate           DateTime      @default(now())
  subtotal              Decimal       @db.Decimal(12, 2)
  taxPercent            Decimal       @default(0) @db.Decimal(5, 2) // single flat rate, no line items
  taxAmount             Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount           Decimal       @db.Decimal(12, 2)
  paidAmount            Decimal       @default(0) @db.Decimal(12, 2)
  paymentAccountId      String? // reference's expense payment `account_id` - debited by paidAmount
  dueAmount             Decimal       @default(0) @db.Decimal(12, 2)
  paymentStatus         PaymentStatus @default(DUE)
  isRecurring           Boolean       @default(false)
  recurringIntervalDays Int?
  nextRecurrenceAt      DateTime?
  receiptUrl            String?
  notes                 String?
  createdBy             String
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  organization              Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category                  ExpenseCategory            @relation(fields: [categoryId], references: [id])
  businessLocation          BusinessLocation           @relation(fields: [businessLocationId], references: [id])
  supplier                  Supplier?                  @relation(fields: [supplierId], references: [id])
  createdByUser             User                       @relation(fields: [createdBy], references: [id])
  paymentAccount            PaymentAccount?            @relation(fields: [paymentAccountId], references: [id], onDelete: SetNull)
  paymentAccountTransaction PaymentAccountTransaction?

  @@unique([businessLocationId, expenseNumber])
  @@index([organizationId])
  @@index([categoryId])
  @@index([businessLocationId])
}

// A periodic branch reconciliation - staff search for "ready" sales (see computeShippingStatus()
// in sale.service.ts) within a date range, manually classify each one into In Stock / Out Stock /
// In Warehouse (InventoryPostingSale below), and record a cash-in-drawer count alongside it.
// Matches the reference's own InventoryPostingController exactly, not an auto-computed snapshot.
model InventoryPosting {
  id                 String                 @id @default(uuid())
  organizationId     String
  businessLocationId String
  postingDate        DateTime               @default(now())
  status             InventoryPostingStatus @default(PENDING)
  cashInDrawer       Decimal                @default(0) @db.Decimal(12, 2)
  // Reference's own search-box fields on the create/edit screen (date range + which employees
  // worked the count) - kept on the posting record itself since the reference persists them
  // alongside the classified result, not just as a transient search filter.
  employeeIds        String[]               @default([])
  searchDateFrom     DateTime?
  searchDateTo       DateTime?
  // Set once reconcile() runs (InventoryPostingController@reconcile) - after this, the posting's
  // OutStock sales are considered settled and the posting itself is locked from further edits.
  reconciledAt       DateTime?
  notes              String?
  createdBy          String
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessLocation BusinessLocation       @relation(fields: [businessLocationId], references: [id])
  createdByUser    User                   @relation(fields: [createdBy], references: [id])
  sales            InventoryPostingSale[]

  @@index([organizationId])
  @@index([businessLocationId])
}

// Join row recording which bucket (In Stock / Out Stock / In Warehouse) a given sale was
// classified into on a specific Inventory Posting - the reference's own per-invoice classify
// action (InventoryPostingController@store's transactions() pivot sync). A sale can only appear
// on one posting at a time (enforced by the unique constraint below combined with the service
// only ever offering "ready" sales not already posted elsewhere).
model InventoryPostingSale {
  id                 String                     @id @default(uuid())
  inventoryPostingId String
  saleId             String
  status             InventoryPostingSaleStatus

  inventoryPosting InventoryPosting @relation(fields: [inventoryPostingId], references: [id], onDelete: Cascade)
  sale             Sale             @relation(fields: [saleId], references: [id])

  @@unique([inventoryPostingId, saleId])
  @@index([saleId])
}

model Message {
  id                     String   @id @default(uuid())
  organizationId         String
  fromBusinessLocationId String
  toBusinessLocationId   String
  subject                String
  content                String   @db.Text
  parentMessageId        String?
  createdBy              String
  createdAt              DateTime @default(now())

  organization         Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fromBusinessLocation BusinessLocation @relation("MessageFromLocation", fields: [fromBusinessLocationId], references: [id])
  toBusinessLocation   BusinessLocation @relation("MessageToLocation", fields: [toBusinessLocationId], references: [id])
  createdByUser        User             @relation(fields: [createdBy], references: [id])
  parentMessage        Message?         @relation("MessageReplies", fields: [parentMessageId], references: [id])
  replies              Message[]        @relation("MessageReplies")

  reads MessageRead[]

  @@index([organizationId])
  @@index([fromBusinessLocationId])
  @@index([toBusinessLocationId])
}

// Per-user read state for a Message - a message is "unread" for a user until they open it, mirroring
// the reference site's user_messages pivot (this is what backs its dashboard unread-count badge).
model MessageRead {
  messageId String
  userId    String
  readAt    DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
}

// Audit trail of every fulfillment-status change on a line item - who changed it, when, from/to.
model SaleItemStatusHistory {
  id         String                 @id @default(uuid())
  saleItemId String
  fromStatus ItemFulfillmentStatus?
  toStatus   ItemFulfillmentStatus
  changedBy  String
  changedAt  DateTime               @default(now())
  note       String?

  saleItem      SaleItem @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  changedByUser User     @relation(fields: [changedBy], references: [id])

  @@index([saleItemId])
}

// A claim for a lost, damaged, or badly delayed garment - initiated against a specific sale
// item where possible (a whole sale if the item can't be pinned down), tracked through to a
// paid/rejected resolution. Distinct from a coupon/discount: this is the shop compensating the
// customer for its own mistake, not a promotional price break.
enum CompensationResolutionType {
  CASH
  POINTS
  COUPON
  CASHBACK
}

model Compensation {
  id                 String                      @id @default(uuid())
  organizationId     String
  saleId             String
  customerId         String
  businessLocationId String
  description        String?
  // Sum of CompensationItem.claimedAmount/approvedAmount (P8-6) - denormalized like
  // SellReturn.totalAmount, computed in create()/resolve(), not independently editable.
  claimedAmount      Decimal                     @db.Decimal(12, 2)
  approvedAmount     Decimal?                    @db.Decimal(12, 2)
  status             CompensationStatus          @default(PENDING)
  // How a PAID claim was actually settled - drives the auto-trigger in compensation.service.ts's
  // resolve(): POINTS credits loyalty points, COUPON auto-generates a single-use coupon,
  // CASHBACK grants a cashback balance (P8-2). CASH stays a plain status flip (no Expense
  // posting wired here yet, even though an Expense model now exists - see Tier 3 of the audit).
  resolutionType     CompensationResolutionType?
  resolutionValue    Decimal?                    @db.Decimal(12, 2)
  resolutionCouponId String?
  resolvedAt         DateTime?
  resolvedBy         String?
  createdBy          String
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sale                 Sale                  @relation(fields: [saleId], references: [id])
  customer             Customer              @relation(fields: [customerId], references: [id])
  businessLocation     BusinessLocation      @relation(fields: [businessLocationId], references: [id])
  createdByUser        User                  @relation("CompensationCreatedBy", fields: [createdBy], references: [id])
  resolvedByUser       User?                 @relation("CompensationResolvedBy", fields: [resolvedBy], references: [id])
  resolutionCoupon     Coupon?               @relation(fields: [resolutionCouponId], references: [id])
  cashbackTransactions CashbackTransaction[]
  items                CompensationItem[]

  @@index([organizationId])
  @@index([saleId])
  @@index([customerId])
  @@index([status])
}

// Line-item claim within a Compensation (P8-6) - mirrors SellReturnItem's shape exactly.
// Reason lives here (per-item), not on the header, since different items in the same claim can
// have different reasons (one lost, one damaged). Header claimedAmount/approvedAmount are the
// sum of these rows.
model CompensationItem {
  id             String             @id @default(uuid())
  compensationId String
  saleItemId     String
  quantity       Decimal            @db.Decimal(12, 3)
  reason         CompensationReason
  claimedAmount  Decimal            @db.Decimal(12, 2)
  approvedAmount Decimal?           @db.Decimal(12, 2)

  compensation Compensation @relation(fields: [compensationId], references: [id], onDelete: Cascade)
  saleItem     SaleItem     @relation(fields: [saleItemId], references: [id])

  @@index([compensationId])
  @@index([saleItemId])
}

// Earn/redeem/adjustment ledger backing Customer.rewardPoints - the balance column is a
// denormalized cache updated alongside each row so reads don't need to sum the whole history.
model LoyaltyTransaction {
  id             String                 @id @default(uuid())
  organizationId String
  customerId     String
  saleId         String?
  type           LoyaltyTransactionType
  points         Int // signed: + earned/adjusted up, - redeemed/adjusted down
  balanceAfter   Int
  note           String?
  createdBy      String?
  createdAt      DateTime               @default(now())

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer      Customer     @relation(fields: [customerId], references: [id])
  sale          Sale?        @relation(fields: [saleId], references: [id])
  createdByUser User?        @relation(fields: [createdBy], references: [id])

  @@index([organizationId])
  @@index([customerId])
}

enum CashbackTransactionType {
  GRANT // manual staff grant or compensation-settlement grant
  REDEEM // spent as a POS payment tender
  ADJUSTMENT // manual balance correction
}

enum CustomerApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// Earn/redeem/adjustment ledger backing Customer.cashBack (P8-2) - same denormalized-balance
// shape as LoyaltyTransaction, but explicitly a separate feature/balance from reward points.
model CashbackTransaction {
  id             String                  @id @default(uuid())
  organizationId String
  customerId     String
  saleId         String? // set when REDEEM happened at POS checkout
  compensationId String? // set when GRANT came from a compensation settlement
  type           CashbackTransactionType
  amount         Decimal                 @db.Decimal(12, 2) // signed: + granted/adjusted up, - redeemed/adjusted down
  balanceAfter   Decimal                 @db.Decimal(12, 2)
  expiresAt      DateTime?
  note           String?
  createdBy      String?
  createdAt      DateTime                @default(now())

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer      Customer      @relation(fields: [customerId], references: [id])
  sale          Sale?         @relation(fields: [saleId], references: [id])
  compensation  Compensation? @relation(fields: [compensationId], references: [id])
  createdByUser User?         @relation(fields: [createdBy], references: [id])

  @@index([organizationId])
  @@index([customerId])
}

// A scheduled home pickup or delivery appointment. `saleId` links it to the invoice once the
// order it represents has actually been rung up - a booking on its own carries no charge.
model Booking {
  id                 String        @id @default(uuid())
  organizationId     String
  businessLocationId String
  customerId         String
  type               BookingType
  scheduledAt        DateTime
  address            String?
  status             BookingStatus @default(REQUESTED)
  saleId             String?
  notes              String?
  createdBy          String
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessLocation BusinessLocation @relation(fields: [businessLocationId], references: [id])
  customer         Customer         @relation(fields: [customerId], references: [id])
  createdByUser    User             @relation(fields: [createdBy], references: [id])

  @@index([organizationId])
  @@index([businessLocationId])
  @@index([customerId])
  @@index([status])
  @@index([scheduledAt])
}

// One SMS provider configuration per tenant - each laundry business has its own Unifonic
// account (unlike Moyasar billing, which is the platform's own collection infrastructure).
// Starts disabled/unconfigured, so every send falls into NotificationLog's TEST mode until the
// tenant enters real credentials here - never blocks or breaks the feature it's attached to.
enum NotificationTrigger {
  ORDER_READY
  ORDER_DELIVERED
  NEW_SALE
  PAYMENT_RECEIVED
  PAYMENT_REMINDER
  COMPENSATION_RESOLVED
  // Reference's action-dropdown "Send Notification" (quotation-only) - the one trigger sent
  // on-demand from a row action rather than automatically as a side effect of some other flow.
  // Also the first trigger sent by email, not just SMS - see notifications.service.ts's
  // sendTemplatedEmail().
  NEW_QUOTATION
}

// Admin-editable, bilingual, per-trigger SMS text with {placeholder} substitution - replaces the
// two hardcoded English-only strings that used to live inline in sale.service.ts. See
// notifications.service.ts's sendTemplatedSms().
model NotificationTemplate {
  id             String              @id @default(uuid())
  organizationId String
  trigger        NotificationTrigger
  messageEn      String              @db.Text
  messageAr      String              @db.Text
  isEnabled      Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, trigger])
}

model NotificationSettings {
  id              String               @id @default(uuid())
  organizationId  String               @unique
  provider        NotificationProvider @default(UNIFONIC)
  appSidEncrypted String? // Unifonic AppSid, encrypted at rest (secretBox, same key as ZATCA signing keys)
  senderId        String?
  enabled         Boolean              @default(false)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model NotificationLog {
  id             String               @id @default(uuid())
  organizationId String
  toPhone        String
  message        String               @db.Text
  status         NotificationStatus
  provider       NotificationProvider
  referenceType  String? // e.g. "SALE"
  referenceId    String?
  errorMessage   String?
  createdAt      DateTime             @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([createdAt])
}

model Payment {
  id                 String      @id @default(uuid())
  saleId             String?
  customerId         String
  businessLocationId String
  amount             Decimal     @db.Decimal(12, 2)
  paymentMethodId    String
  type               PaymentType @default(SALE_PAYMENT)
  referenceNumber    String?
  paymentDate        DateTime    @default(now())
  notes              String?
  // Reference's auto-generated `payment_ref_no` (SP-000001) - claimed per branch at creation.
  paymentRefNo       String?
  // Reference's `transaction_payments.account_id` - which payment account this payment landed in.
  paymentAccountId   String?
  createdBy          String
  createdAt          DateTime    @default(now())

  paymentAccount            PaymentAccount?            @relation(fields: [paymentAccountId], references: [id], onDelete: SetNull)
  paymentAccountTransaction PaymentAccountTransaction?
  sale                      Sale?                      @relation(fields: [saleId], references: [id])
  customer                  Customer                   @relation(fields: [customerId], references: [id])
  businessLocation          BusinessLocation           @relation(fields: [businessLocationId], references: [id])
  paymentMethod             PaymentMethod              @relation(fields: [paymentMethodId], references: [id])
  createdByUser             User                       @relation(fields: [createdBy], references: [id])

  @@index([saleId])
  @@index([customerId])
}

// ---------------------------------------------------------------------------
// Register sessions - cashier opens a drawer with a starting float, closes it at end of shift
// with an expected-vs-counted cash reconciliation. Attaching a sale to a session is optional -
// checkout still works with no register open, so this never blocks existing POS usage.
// ---------------------------------------------------------------------------

model RegisterSession {
  id                 String                @id @default(uuid())
  organizationId     String
  businessLocationId String
  openedBy           String
  openedAt           DateTime              @default(now())
  openingCashAmount  Decimal               @default(0) @db.Decimal(12, 2)
  closedBy           String?
  closedAt           DateTime?
  expectedCashAmount Decimal?              @db.Decimal(12, 2) // derived from the RegisterTransaction ledger: sum(CREDIT) - sum(DEBIT)
  countedCashAmount  Decimal?              @db.Decimal(12, 2) // what the cashier actually counted at close
  cashDifference     Decimal?              @db.Decimal(12, 2) // countedCashAmount - expectedCashAmount
  denominations      Json? // optional bill/coin counts captured at close, e.g. {"500": 1, "100": 3, ...}
  notes              String?
  status             RegisterSessionStatus @default(OPEN)

  organization     Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessLocation BusinessLocation      @relation(fields: [businessLocationId], references: [id])
  openedByUser     User                  @relation("RegisterSessionOpenedBy", fields: [openedBy], references: [id])
  closedByUser     User?                 @relation("RegisterSessionClosedBy", fields: [closedBy], references: [id])
  sales            Sale[]
  transactions     RegisterTransaction[]

  @@index([organizationId])
  @@index([businessLocationId])
  @@index([status])
}

enum RegisterTransactionType {
  CREDIT
  DEBIT
}

// Every cash movement through an open drawer - the opening float, cash sale payments, cash
// refunds - is a ledger row here. expectedCashAmount at close is derived by summing these rather
// than reconstructed from Payment rows, so refunds (type DEBIT) are never silently missed.
model RegisterTransaction {
  id                String                  @id @default(uuid())
  registerSessionId String
  type              RegisterTransactionType
  amount            Decimal                 @db.Decimal(12, 2) // always positive; type carries the sign
  paymentMethod     String
  referenceType     String?
  referenceId       String?
  note              String?
  createdAt         DateTime                @default(now())

  registerSession RegisterSession @relation(fields: [registerSessionId], references: [id], onDelete: Cascade)

  @@index([registerSessionId])
}

// ---------------------------------------------------------------------------
// Held ("suspended") sales - a cart parked mid-build so the cashier can serve another customer
// and resume later. Persisted server-side (not just browser memory) so it survives a refresh,
// a different terminal, or the cashier logging out and back in.
// ---------------------------------------------------------------------------

model HeldSale {
  id                 String   @id @default(uuid())
  organizationId     String
  businessLocationId String
  customerId         String?
  label              String
  note               String?
  createdBy          String
  createdAt          DateTime @default(now())

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessLocation BusinessLocation @relation(fields: [businessLocationId], references: [id])
  customer         Customer?        @relation(fields: [customerId], references: [id])
  createdByUser    User             @relation(fields: [createdBy], references: [id])
  items            HeldSaleItem[]

  @@index([organizationId])
  @@index([businessLocationId])
}

model HeldSaleItem {
  id             String  @id @default(uuid())
  heldSaleId     String
  productId      String?
  serviceId      String?
  descriptionEn  String
  descriptionAr  String?
  quantity       Decimal @db.Decimal(12, 3)
  unitPrice      Decimal @db.Decimal(12, 2)
  taxPercent     Decimal @default(0) @db.Decimal(5, 2)
  taxType        TaxType @default(EXCLUSIVE)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)

  heldSale HeldSale @relation(fields: [heldSaleId], references: [id], onDelete: Cascade)
  product  Product? @relation(fields: [productId], references: [id])
  service  Service? @relation(fields: [serviceId], references: [id])

  @@index([heldSaleId])
}

// ---------------------------------------------------------------------------
// Coupons - redeemable discount codes. Validity and the discount amount are always recomputed
// and applied server-side at checkout; the client only ever sends the code, never the amount.
// ---------------------------------------------------------------------------

model Coupon {
  id                String             @id @default(uuid())
  organizationId    String
  code              String
  discountMode      CouponDiscountMode
  discountValue     Decimal            @db.Decimal(12, 2)
  minPurchaseAmount Decimal            @default(0) @db.Decimal(12, 2)
  maxUses           Int? // null = unlimited (org-wide total)
  usedCount         Int                @default(0)
  validFrom         DateTime?
  validUntil        DateTime?
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  // Targeting - all null = unrestricted (matches the existing org-wide default). Deliberately no
  // category/product targeting here - that requires restructuring discount math from cart-level to
  // per-line, the same undertaking as the Promotion engine (Tier 3/4), not a small addition.
  businessLocationId String?
  customerId         String?
  customerGroupId    String?
  maxUsesPerCustomer Int? // null = unlimited (per-customer)
  maxDiscountAmount  Decimal? @db.Decimal(12, 2) // ceiling on the computed discount - only meaningful for PERCENT mode

  organization            Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessLocation        BusinessLocation? @relation(fields: [businessLocationId], references: [id])
  customer                Customer?         @relation(fields: [customerId], references: [id])
  customerGroup           CustomerGroup?    @relation(fields: [customerGroupId], references: [id])
  sales                   Sale[]
  compensationResolutions Compensation[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([businessLocationId])
  @@index([customerId])
}

// ---------------------------------------------------------------------------
// Price lists - a customer (or their customer group) can be pinned to negotiated pricing
// instead of the shared catalog price. A customer's own list wins over their group's; no list
// on either falls back to the product/service's normal price - see pos.service.ts priceLine().
// ---------------------------------------------------------------------------

model PriceList {
  id             String   @id @default(uuid())
  organizationId String
  nameEn         String
  nameAr         String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items               PriceListItem[]
  customers           Customer[]
  customerGroups      CustomerGroup[]
  defaultForLocations BusinessLocation[]
  sales               Sale[]

  @@unique([organizationId, nameEn])
  @@index([organizationId])
}

model PriceListItem {
  id          String  @id @default(uuid())
  priceListId String
  productId   String?
  serviceId   String?
  price       Decimal @db.Decimal(12, 2)

  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  product   Product?  @relation(fields: [productId], references: [id])
  service   Service?  @relation(fields: [serviceId], references: [id])

  @@unique([priceListId, productId])
  @@unique([priceListId, serviceId])
  @@index([priceListId])
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String?
  userId         String?
  action         String // e.g. "CREATE", "UPDATE", "DELETE", "LOGIN"
  module         String // e.g. "products", "sales"
  entityId       String?
  oldValues      Json?
  newValues      Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([module])
  @@index([entityId])
  @@index([createdAt])
}
