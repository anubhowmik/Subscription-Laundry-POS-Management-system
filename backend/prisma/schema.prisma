model ServiceCategory {
  id             String     @id @default(uuid())
  organizationId String
  nameEn         String
  nameAr         String
  description    String?
  status         UserStatus @default(ACTIVE)
  // Sales targets, as on product categories (a laundry item is a Service here).
  target         Decimal?   @db.Decimal(14, 2)
  targetMtd      Decimal?   @db.Decimal(14, 2)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  services     Service[]

  @@index([organizationId])
}

model Service {
  id                       String     @id @default(uuid())
  organizationId           String
  nameEn                   String
  nameAr                   String
  code                     String
  categoryId               String?
  unitId                   String
  price                    Decimal    @db.Decimal(12, 2)
  taxId                    String?
  estimatedProcessingHours Int        @default(24)
  descriptionEn            String?
  descriptionAr            String?
  status                   UserStatus @default(ACTIVE)
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt

  organization      Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category          ServiceCategory?          @relation(fields: [categoryId], references: [id])
  unit              Unit                      @relation(fields: [unitId], references: [id])
  tax               Tax?                      @relation(fields: [taxId], references: [id])
  businessLocations ServiceBusinessLocation[]
